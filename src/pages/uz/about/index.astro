---
import Base from '../../../layouts/Base.astro';

const timeline = [
  { year: '2021', title: 'Sanoat monitoringi yo\'nalishining boshlanishi', body: "Ishlab chiqaruvchi prediktiv diagnostika va ASU TP bilan bozorga chiqadi. «Larus» edge-shlyuzining ishlanmasi Rossiya Sanoat-savdo vazirligi granti bilan qo'llab-quvvatlangan. Og'ir ishlab chiqarishlarda birinchi pilotlar." },
  { year: '2022', title: 'Platforma sanoat ekspluatatsiyasida', body: "Monitoring va diagnostika platformasi (vibro- va tok diagnostikasi, ToiR) sanoat ekspluatatsiyasiga chiqadi." },
  { year: '2026', title: 'ServerPro — Markaziy Osiyoda rasmiy vakil', body: "ServerPro Passer/Larus/Strix liniyasining O'zbekiston, Qozog'iston va Qirg'iziston hududidagi rasmiy vakili maqomini oladi." },
];

const competencies = [
  {
    title: 'Vibro- va tok diagnostikasi',
    body: "92 kGts gacha vibroakustika yig'ish kontrollerlari («Passer-V») va motorlar tok signaturasi («Passer-T»). «Larus»da edge-analitika, ML-klassifikatorlar, RUL.",
  },
  {
    title: 'APC va raqamli egizaklar',
    body: "IEC 63278 (AAS) bo'yicha aktivning raqamli egizagi bilan «Strix» platformasi. Real vaqtda boshqaruvchi ta'sir, operatorga maslahatchi.",
  },
  {
    title: 'Edge-hisoblashlar va avtomatlashtirish',
    body: "«Larus-100»da Eclipse 4diac (IEC 61499). Determinlashgan bloklashlar, ketma-ketliklar, edge'da skid darajasidagi boshqaruv.",
  },
];
---
<Base locale="uz" title="Kompaniya haqida — ServerPro" description="ServerPro — O'zbekiston, Qozog'iston va Qirg'izistonda vibrodiagnostika, tok diagnostikasi va APC uchun mahsulotlarning (Passer/Larus/Strix) rasmiy mintaqaviy vakili. Bundan tashqari — muhandislik tizimlari va xavfsizlik monitoringi bo'yicha o'z xizmatlari.">
  <!-- Hero: ServerPro сам -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-50 [mask-image:radial-gradient(ellipse_at_top,_black_30%,_transparent_70%)]"></div>
    <div class="container-x relative grid gap-12 py-20 md:grid-cols-12 md:py-28">
      <div class="md:col-span-8">
        <span class="pill-accent">
          <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
          Kompaniya haqida
        </span>
        <h1 class="mt-6 font-display text-display-xl text-navy">
          Sizning mintaqaviy <span class="text-gold">vakilingiz.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-ink-muted">
          ServerPro (Toshkent) — O'zbekiston, Qozog'iston va Qirg'iziston hududida vibrodiagnostika, tok diagnostikasi va APC uchun «Passer»/«Larus»/«Strix» liniyasining rasmiy mintaqaviy vakili. O'z nomidan sotuv, kafolat va servis xizmati, tender arizalarini qo'llab-quvvatlash.
        </p>
        <p class="mt-4 max-w-2xl text-base text-ink-muted">
          Ushbu liniya bilan bir qatorda ServerPro o'z kuchi bilan muhandislik tizimlari va obyektlar xavfsizligi monitoringi xizmatlarini olib boradi — qarang: <a href="/uz/services/" class="font-semibold text-navy hover:text-gold-600">Bizning xizmatlar</a>.
        </p>
        <div class="mt-10 grid grid-cols-3 gap-4 max-w-xl">
          <div>
            <div class="font-display text-3xl font-semibold text-navy">2026</div>
            <div class="mt-1 text-xs uppercase tracking-[0.14em] text-ink-muted">shu yildan rasmiy vakil</div>
          </div>
          <div>
            <div class="font-display text-3xl font-semibold text-navy">3</div>
            <div class="mt-1 text-xs uppercase tracking-[0.14em] text-ink-muted">mintaqa davlati</div>
          </div>
          <div>
            <div class="font-display text-3xl font-semibold text-navy">8</div>
            <div class="mt-1 text-xs uppercase tracking-[0.14em] text-ink-muted">o'z xizmatlari</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Реквизиты ServerPro -->
  <section class="border-y border-navy/10 bg-white py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <div class="eyebrow">Kompaniya</div>
        <h2 class="mt-3 text-display-lg">ServerPro raqamlar va rekvizitlarda.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <div class="card">
          <div class="eyebrow text-gold-600">Yuridik shaxs</div>
          <div class="mt-2 font-display text-2xl font-semibold text-navy">«SERVERPRO» MChJ</div>
          <dl class="mt-6 space-y-3 text-sm">
            <div class="flex justify-between gap-4 border-b border-navy/5 pb-3"><dt class="text-ink-muted">STIR</dt><dd class="font-medium text-navy">311028163</dd></div>
            <div class="flex justify-between gap-4 border-b border-navy/5 pb-3"><dt class="text-ink-muted">Manzil</dt><dd class="text-right font-medium text-navy">Toshkent, Yunusobod tumani,<br/>13-kvartal, 3-uy</dd></div>
            <div class="flex justify-between gap-4 border-b border-navy/5 pb-3"><dt class="text-ink-muted">Direktor</dt><dd class="font-medium text-navy">G'afarov I.I.</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-ink-muted">Telefon</dt><dd class="font-medium text-navy">+998 90 397-24-99</dd></div>
          </dl>
        </div>
        <div class="card">
          <div class="eyebrow text-gold-600">Maqom</div>
          <div class="mt-2 font-display text-2xl font-semibold text-navy">Rasmiy vakil</div>
          <p class="mt-3 text-sm text-ink-muted">«Passer»/«Larus»/«Strix» mahsulotlari O'zbekiston, Qozog'iston va Qirg'iziston hududida — o'z nomidan sotuv, kafolat va servis xizmati, buyurtma asosida ishlab chiqarishga arizalar qabul qilish.</p>
          <p class="mt-4 text-sm text-ink-muted">Shuningdek, bitta ishlab chiqaruvchiga bog'lanmagan o'z xizmatlarimizni olib boramiz — muhandislik tizimlari, konstruksiyalar monitoringi va xavfsizlik (hamkor brendlar: Spektron UPOS, Polymedia, META).</p>
        </div>
        <div class="card">
          <div class="eyebrow text-gold-600">ServerPro kompetensiyalari</div>
          <div class="mt-2 font-display text-2xl font-semibold text-navy">Texnik qo'mitalar a'zosi</div>
          <dl class="mt-6 space-y-3 text-sm">
            <div class="flex justify-between gap-4 border-b border-navy/5 pb-3"><dt class="text-ink-muted">TK 269</dt><dd class="text-right font-medium text-navy">Kon ishi</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-ink-muted">TK 071</dt><dd class="text-right font-medium text-navy">Fuqaro muhofazasi</dd></div>
          </dl>
          <p class="mt-4 text-sm text-ink-muted">TK 269dagi a'zolik ServerPro'ning ko'mir sanoati xavfsizligiga ixtisoslashuvini bevosita aks ettiradi — qarang: <a href="/uz/projects/" class="font-semibold text-navy hover:text-gold-600">bizning loyihalar</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Технология, которую мы представляем -->
  <section class="py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <div class="eyebrow">Biz vakillik qiladigan texnologiya</div>
        <h2 class="mt-3 text-display-lg">To'liq stek: datchikdan maslahatchigacha.</h2>
        <p class="mt-4 text-lg text-ink-muted">
          «Bulutli vibro-xizmat» emas. Ishlab chiqaruvchining o'z apparati va dasturiy ta'minoti, og'ir sanoatda o'n yillik real ekspluatatsiya — ServerPro bu liniyani mintaqada yetkazib beradi va texnik xizmat ko'rsatadi.
        </p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {competencies.map((c) => (
          <div class="card flex flex-col">
            <div class="font-display text-xl font-semibold text-navy">{c.title}</div>
            <p class="mt-3 text-sm text-ink-muted">{c.body}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 max-w-2xl text-sm text-ink-muted">
        Metodika ishlab chiqaruvchining R&D-amaliyotiga asoslangan: ITMO bilan hamkorlik (AI-yadro), Buyuk Pyotr Politexnikasida (SPbPU) o'quv-tadqiqot laboratoriyasi, ishlanma Rossiya Sanoat-savdo vazirligi granti bilan qo'llab-quvvatlangan.
      </p>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <div class="eyebrow">Xronologiya</div>
        <h2 class="mt-3 text-display-lg">Ishlanmadan — mintaqaviy vakillikkacha.</h2>
      </div>
      <div class="mt-12 grid gap-4">
        {timeline.map((t) => (
          <div class="card grid gap-3 md:grid-cols-12 md:items-start">
            <div class="md:col-span-2">
              <div class="font-display text-2xl font-semibold tracking-tight text-gold-600">{t.year}</div>
            </div>
            <div class="md:col-span-3">
              <div class="font-display text-base font-semibold text-navy">{t.title}</div>
            </div>
            <div class="md:col-span-7">
              <p class="text-sm text-ink-muted">{t.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contact-about" class="bg-navy py-20 text-cream">
    <div class="container-x grid items-center gap-8 md:grid-cols-12">
      <div class="md:col-span-7">
        <div class="eyebrow text-gold">Kontakt</div>
        <h2 class="mt-3 font-display text-display-md text-cream">
          Jamoa bilan gaplashamizmi?
        </h2>
        <p class="mt-3 text-cream/70">
          Pilot, narx hisobi yoki shunchaki aktivingiz haqida suhbat — qulay formatni tanlang.
        </p>
      </div>
      <div class="md:col-span-5 flex flex-wrap gap-3 md:justify-end">
        <a href="/uz/#contact" class="btn-accent">Demoga yozilish →</a>
        <a href="mailto:info@server-pro.uz" class="btn-ghost !border-cream/20 !bg-white/5 !text-cream hover:!bg-white/10">info@server-pro.uz</a>
      </div>
    </div>
  </section>
</Base>
