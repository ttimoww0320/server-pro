---
import Base from '../../../layouts/Base.astro';

const tiers = [
  {
    name: 'Vakolatli',
    commit: 'Yillik majburiyatlarsiz',
    discount: '20%',
    renewal: '10% Y2+',
    perks: [
      'Passer/Larus/Strix liniyasi mahsulotlariga standart chegirma',
      'Kiruvchi lidlarni sizning hududingiz bo\'yicha taqsimlash',
      'Hamkorlik portali va sotuv materiallariga kirish',
      'Pochta orqali qo\'llab-quvvatlash',
    ],
    accent: false,
  },
  {
    name: 'Kumush',
    commit: '$50 000 / yil',
    discount: '25%',
    renewal: '15% Y2+',
    perks: [
      'Mintaqaviy kiruvchi lidlarga ustuvorlik',
      '/partners sahifasida joylashtirish',
      'ServerPro jamoasi bilan choraklik uchrashuv',
      'Birgalikda ishlab chiqilgan pilot takliflar',
    ],
    accent: false,
  },
  {
    name: 'Oltin',
    commit: '$200 000 / yil',
    discount: '30%',
    renewal: '20% Y2+',
    perks: [
      '$1 000 000 gacha bo\'lgan bitimlar bo\'yicha ustuvor tijoriy shartlar',
      'Qo\'shma marketing — keyslar, vebinarlar, tadbirlar',
      '/partners sahifasida logotip va tavsif',
      'Ajratilgan texnik presale muhandisi',
    ],
    accent: true,
  },
  {
    name: 'Platina',
    commit: '$750 000 / yil',
    discount: '35%',
    renewal: '25% Y2+',
    perks: [
      '$5 000 000 gacha bo\'lgan bitimlar bo\'yicha ustuvor tijoriy shartlar',
      '/partners sahifasida va buyurtmachilar uchun materiallarda birinchi qatordagi logotip',
      'Yangi proshivkalar va platforma funksiyalariga erta kirish',
      'Mahsulot kengashida o\'rin, yo\'l xaritasiga ta\'sir',
    ],
    accent: false,
  },
];

const why = [
  {
    title: 'Bir stekda apparat va dasturiy ta\'minot',
    body: 'Monitoring vendorlarining aksariyati — faqat dasturiy ta\'minot yoki faqat apparat. Passer/Larus/Strix liniyasi ikkalasini ham qamrab oladi. Bitta hamkor loyihaga kiradi, uni kengaytiradi va yillar davomida daromadini oshiradi.',
  },
  {
    title: 'Ochiq interfeyslar, vendor lock-in\'siz',
    body: 'OPC UA, MQTT Sparkplug, AAS, Kafka — buyurtmachilar proprietar vositalarsiz integratsiyalashadi, migratsiya qiladi va kengayadi. Sotish osonroq, xaridlar oldida himoya qilish osonroq.',
  },
  {
    title: 'Haqiqatan eshiklarni ochadigan mahsulot',
    body: '«Strix.Shlyuz» — buyurtmachining muhandisi 30 daqiqada o\'rnatadi va to\'liq dasturiy ta\'minotni sotib olishdan oldin ilk ma\'lumotlarni ko\'radi. Konversiya har qanday standart demodan yuqori.',
  },
  {
    title: 'Haqiqiy muhandislik chuqurligi',
    body: 'Liniya ishlab chiqaruvchisi sanoat monitoringini 2016-yildan beri rivojlantirib keladi — ServerPro esa mintaqada mahalliy kuzatuv, servis va texnik yordamni ta\'minlaydi, siz bilan faqat bitim ustida emas, yechim arxitekturasi ustida ishlaydi.',
  },
];

const ideal = [
  'Kon qazib olish, neft-gaz, sement, shisha, energetikada real ishtirokka ega tizim integratorlari',
  'Jiddiy dasturiy stekka ega vendor izlayotgan OT/IIoT-konsalting',
  'Portfelga dasturiy ta\'minot va shlyuzlarni qo\'shmoqchi bo\'lgan servis-hamkorlar (vibro-tahlil, ishonchlilik)',
  'Qozog\'iston, Qirg\'iziston, Tojikiston va mintaqaning boshqa mamlakatlarida o\'z texnik presale\'ga ega distribyutorlar',
];
---
<Base locale="uz" title="Hamkorlar uchun — ServerPro" description="ServerPro hamkorlik dasturi: «Vakolatli», «Kumush», «Oltin», «Platina» darajalari — Qozog'iston, Qirg'iziston va mintaqaning boshqa mamlakatlaridagi tizim integratorlari, OT-konsalting, distribyutorlar va servis-hamkorlar uchun.">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-cream py-20 md:py-28">
    <div class="absolute inset-0 grid-bg opacity-50 [mask-image:radial-gradient(ellipse_at_top,_black_30%,_transparent_70%)]"></div>
    <div class="container-x relative max-w-3xl">
      <span class="pill-accent">
        <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
        Hamkorlik dasturi
      </span>
      <h1 class="mt-6 font-display text-display-xl text-navy">
        ServerPro subdileri bo'ling <span class="text-gold">o'z mamlakatingizda.</span>
      </h1>
      <p class="mt-6 text-lg text-ink-muted">
        ServerPro — Passer/Larus/Strix liniyasining Markaziy Osiyodagi rasmiy vakili — Qozog'iston, Qirg'iziston va qo'shni mamlakatlarda mintaqaviy hamkorlar izlamoqda. Tizim integratori, OT-konsalting, servis-kompaniya yoki distribyutor — mahsulot hamkorlar orqali sotilishi va yetkazib berilishi uchun loyihalangan. Real marja, ustuvor shartlar, haqiqiy muhandislik yordami.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#apply" class="btn-accent">Ariza topshirish →</a>
        <a href="#tiers" class="btn-ghost">Dastur darajalari</a>
      </div>
    </div>
  </section>

  <!-- Why partner -->
  <section class="py-20">
    <div class="container-x">
      <div class="max-w-2xl">
        <div class="eyebrow">Nega hamkorlik qilish arziydi</div>
        <h2 class="mt-3 text-display-lg">Hamkor yutadi, omon qolish uchun kurashmaydi.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {why.map((w) => (
          <div class="card">
            <div class="font-display text-lg font-semibold text-navy">{w.title}</div>
            <p class="mt-2 text-sm text-ink-muted">{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tiers -->
  <section id="tiers" class="bg-white py-20">
    <div class="container-x">
      <div class="max-w-2xl">
        <div class="eyebrow">Dastur darajalari</div>
        <h2 class="mt-3 text-display-lg">To'rt daraja. Marja majburiyatlar bilan birga o'sadi.</h2>
        <p class="mt-3 text-ink-muted">
          Chegirmalar dasturiy ta'minot, uskuna va aksessuarlar narxnomasiga qo'llaniladi. Xizmatlar (joriy etish, o'qitish) to'liq narxnoma bo'yicha taqdim etiladi.
        </p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {tiers.map((t) => (
          <div class={`card flex flex-col ${t.accent ? 'border-gold/40 ring-2 ring-gold/30' : ''}`}>
            {t.accent && <div class="eyebrow">Ko'pincha tanlanadi</div>}
            <div class={`font-display text-2xl font-semibold ${t.accent ? 'text-gold-600' : 'text-navy'}`}>{t.name}</div>
            <div class="mt-1 text-xs uppercase tracking-wider text-ink-muted">{t.commit}</div>
            <div class="mt-6 flex items-baseline gap-2">
              <span class="font-display text-4xl font-semibold text-navy">{t.discount}</span>
              <span class="text-sm text-ink-muted">narxnomadan</span>
            </div>
            <div class="mt-1 text-xs text-ink-muted">+ {t.renewal} uzaytirishlarda</div>
            <ul class="mt-6 space-y-2 border-t border-navy/10 pt-5 text-sm text-ink-muted">
              {t.perks.map((p) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-gold"></span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-12 rounded-2xl border border-navy/10 bg-cream p-6 text-sm text-ink-muted">
        <strong class="text-navy">Uskuna uchun hajmli narxlash</strong> daraja chegirmasi bilan qo'shiladi: 10–49 dona uchun 10%, 50–199 uchun 15%, 200+ uchun 20% (individual shartlar). <strong class="text-navy">Dasturiy ta'minotga hajmli chegirma</strong>: bitta shartnomada ≥ 5 shlyuz bo'lganda har bir shlyuz uchun 15%, ≥ 25 bo'lganda 25%.
      </div>
    </div>
  </section>

  <!-- Ideal partner -->
  <section class="py-20">
    <div class="container-x grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <div class="eyebrow">Kim mos keladi</div>
        <h2 class="mt-3 text-display-lg">Ideal hamkor profili</h2>
        <p class="mt-4 text-ink-muted">Biz tanlab olamiz. Kamroq hamkor — chuqurroq munosabatlar. Ikki narsa muhim: texnik presale va sohada qaror qabul qiluvchilarga kirish imkoni.</p>
      </div>
      <div class="md:col-span-7">
        <ul class="space-y-3">
          {ideal.map((i) => (
            <li class="card flex items-start gap-3">
              <span class="mt-1 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-gold/15 text-xs font-semibold text-gold-600">✓</span>
              <span class="text-sm text-ink-muted">{i}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Apply -->
  <section id="apply" class="py-20">
    <div class="container-x">
      <div class="relative overflow-hidden rounded-3xl bg-navy px-8 py-14 text-cream md:px-16 md:py-20">
        <div class="absolute -right-20 -top-20 h-80 w-80 rounded-full bg-gold/20 blur-3xl"></div>
        <div class="grid gap-12 md:grid-cols-2">
          <div>
            <div class="eyebrow text-gold">Ariza topshirish</div>
            <h2 class="mt-3 font-display text-display-md text-cream">
              Biznesingiz haqida so'zlab bering.
            </h2>
            <p class="mt-4 max-w-md text-cream/70">
              Arizalarni har hafta ko'rib chiqamiz. 30 daqiqalik tanishuvdan so'ng hudud, joriy buyurtmachilar va muhandislik imkoniyatlarini hisobga olib boshlang'ich darajani taklif qilamiz.
            </p>
            <ul class="mt-6 space-y-2 text-sm text-cream/80">
              <li class="flex items-start gap-2"><span class="mt-1 h-1.5 w-1.5 rounded-full bg-gold"></span>Ariza berilgach, bir hafta ichida tanishuv</li>
              <li class="flex items-start gap-2"><span class="mt-1 h-1.5 w-1.5 rounded-full bg-gold"></span>NDA + hamkorlik shartnomasi 14 kunda</li>
              <li class="flex items-start gap-2"><span class="mt-1 h-1.5 w-1.5 rounded-full bg-gold"></span>Hududingizdan birinchi lid — 30 kun ichida</li>
            </ul>
          </div>
          <form class="grid gap-3 rounded-2xl bg-white/5 p-6 backdrop-blur-md ring-1 ring-cream/10" method="post" action="/api/partner-apply">
            <div class="grid grid-cols-2 gap-3">
              <input class="rounded-lg bg-cream/95 px-4 py-3 text-sm text-navy placeholder:text-ink-muted" name="name" placeholder="Ismingiz" required />
              <input class="rounded-lg bg-cream/95 px-4 py-3 text-sm text-navy placeholder:text-ink-muted" name="company" placeholder="Kompaniya" required />
            </div>
            <input class="rounded-lg bg-cream/95 px-4 py-3 text-sm text-navy placeholder:text-ink-muted" type="email" name="email" placeholder="Korporativ pochta" required />
            <input class="rounded-lg bg-cream/95 px-4 py-3 text-sm text-navy placeholder:text-ink-muted" name="country" placeholder="Mamlakat / mintaqa" required />
            <select class="rounded-lg bg-cream/95 px-4 py-3 text-sm text-navy" name="category" required>
              <option value="">Biznes turi…</option>
              <option>Tizim integratori</option>
              <option>OT / IIoT-konsalting</option>
              <option>Servis-hamkor (vibro-tahlil, ishonchlilik)</option>
              <option>Distribyutor / reseller</option>
              <option>Boshqa</option>
            </select>
            <textarea class="min-h-24 rounded-lg bg-cream/95 px-4 py-3 text-sm text-navy placeholder:text-ink-muted" name="message" placeholder="Qisqacha: tarmoqlar, maqsadli buyurtmachilar, Passer/Larus/Strix liniyasi bilan nima qilishni rejalashtiryapsiz"></textarea>
            <button class="btn-accent mt-1" type="submit">Arizani yuborish</button>
            <div class="text-[11px] text-cream/60">Har bir arizani shaxsan o'qiymiz. Javob 5 ish kuni ichida.</div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>
