---
import Base from '../../../layouts/Base.astro';

const stack = [
  { layer: 'L0 · Signal', products: 'Passer-V · Passer-T', body: "8 ta IEPE kanali, 92 kGts, 24 bit. Motor toki bo'yicha MCSA. Aktiv stetoskopi." },
  { layer: 'L1 · Edge', products: 'Larus-10 / 100 / 1000', body: "FFT, o'rovchi, RMS, edge'da ML-inferens. IEC 61499 (4diac). Real vaqtdagi kardiogramma." },
  { layer: 'L2 · Platforma', products: 'Strix · Diagnostics + APC', body: "Raqamli egizak, RUL, operatorga maslahatchi, boshqaruvchi ta'sir. Terapevt + davolashni tayinlash." },
  { layer: 'L3 · Dashbordlar', products: 'Strix.Platforma · web + mobile', body: "Dashbordlar va ARM — egasiga, moliya direktoriga, muhandisga. Brauzerda va smartfonda, rollarga ko'ra kirish." },
];

const pillars = [
  {
    title: "Signal yig'ish",
    bullets: [
      'Passer-V — 8 ta IEPE kanali, 92 kGts gacha, 24 bit',
      'Passer-T — motor tok signaturasini tahlil qilish (MCSA)',
      "«Larus»ga Ethernet orqali xom oqim — yo'qotishsiz, agregatsiyasiz",
    ],
  },
  {
    title: 'Tahlil va qaror',
    bullets: [
      "Larus-10 — edge'da diagnostika, pilotlar uchun",
      'Larus-100 — IEC 61499 (4diac), edge-avtomatlashtirish',
      'Larus-1000 — turnkey + NPU, bortida Strix bilan',
    ],
  },
  {
    title: 'Harakat',
    bullets: [
      'OPC UA, MQTT Sparkplug, AAS — ochiq standartlar',
      'Bulut · sizning serveringiz · pristavka — sizning tanlovingiz',
      "Strix.Shlyuz — OT↔IT ma'lumot yig'ish (OPC UA, Modbus, MQTT)",
    ],
  },
];
---
<Base locale="uz" title="Bosh muhandis uchun" description="92 kGts vibroakustikadan APC gacha. Spektrlar, RUL, maslahatchi. To'liq L0–L3 stek.">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-50 [mask-image:radial-gradient(ellipse_at_top,_black_30%,_transparent_70%)]"></div>
    <div class="container-x relative grid gap-12 py-20 md:grid-cols-12 md:py-28">
      <div class="md:col-span-7">
        <span class="pill-accent">
          <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
          Bosh muhandis uchun
        </span>
        <h1 class="mt-6 font-display text-display-xl text-navy">
          Chuqurlik — <span class="text-gold">siz kutgan darajada.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-ink-muted">
          92 kGts vibroakustikadan APC boshqaruvchi ta'sirigacha — bitta stekda, bitta data fabric ichida. Spektrlar, RUL, maslahatchi. «Bulutli vibro xizmat sifatida» emas, balki o'z jihozingizda joylashtira oladigan to'liq L0–L3 stek.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="https://docs.liman-tech.ru/" target="_blank" rel="noopener noreferrer" class="btn-accent">Hujjatlar ↗</a>
          <a href="/uz/?intent=diagnostic-day#contact" class="btn-ghost">Diagnostika kuni →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stack L0-L3 -->
  <section class="border-y border-navy/10 bg-white py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <div class="eyebrow">L0–L3 stek</div>
        <h2 class="mt-3 text-display-lg">Bitta stek — to'rt daraja.</h2>
        <p class="mt-4 text-lg text-ink-muted">
          Har bir daraja — ochiq hujjatlar va standart protokollarga ega alohida mahsulot. To'liq oling yoki alohida qismlar bilan — standartlar birinchi o'rinda.
        </p>
      </div>
      <div class="mt-12 grid gap-4">
        {stack.map((s) => (
          <div class="card grid gap-3 md:grid-cols-12 md:items-center">
            <div class="md:col-span-2">
              <div class="font-mono text-xs uppercase tracking-[0.18em] text-gold-600">{s.layer}</div>
            </div>
            <div class="md:col-span-3">
              <div class="font-display text-base font-semibold text-navy">{s.products}</div>
            </div>
            <div class="md:col-span-7">
              <p class="text-sm text-ink-muted">{s.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sense / Decide / Act — full pillars -->
  <section class="py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <div class="eyebrow">Platforma</div>
        <h2 class="mt-3 text-display-lg">Sense / Decide / Act — bu qanday ishlaydi.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {pillars.map((p, i) => (
          <div class="card flex flex-col">
            <div class="eyebrow">{i + 1}-qadam</div>
            <div class="mt-3 font-display text-2xl font-semibold text-navy">{p.title}</div>
            <ul class="mt-4 space-y-2 border-t border-navy/8 pt-4 text-sm text-ink">
              {p.bullets.map((b) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold"></span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
