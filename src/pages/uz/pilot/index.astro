---
import Base from '../../../layouts/Base.astro';
import { TRACK_1, TRACK_2, type IntentDef } from '../../../lib/intents.uz';

const tracks = [
  {
    title: 'Monitoring va diagnostika',
    eyebrow: 'Yo\'nalish 1',
    body: "Agar maqsad — aktivlarga vibro- va tok diagnostikasini o'rnatish, SCADA / TXK bilan integratsiya qilish va sanoat ekspluatatsiyasiga chiqarish bo'lsa. Yakuniy natija — uskuna va DT yetkazib berish (kapital qo'yilma) yoki tender bo'yicha yetkazib berish.",
    items: TRACK_1,
  },
  {
    title: 'APC va jarayonni optimallashtirish',
    eyebrow: 'Yo\'nalish 2',
    body: "Agar maqsad — chiqishni oshirish, energiyani kamaytirish, jarayonni barqarorlashtirish bo'lsa. Yakuniy natija — konturdagi APC algoritmi. Tijorat modeli: bir martalik sotuv yoki servis shartnomasi (natija uchun to'laysiz).",
    items: TRACK_2,
  },
];

function ladderHref(item: IntentDef) {
  return `/uz/?intent=${item.id}#contact`;
}
---
<Base locale="uz" title="Nimadan boshlash kerak" description="Ikki yo'nalish bo'yicha to'rt kirish darajasi: monitoring (Demo · Diagnostika kuni · Pilot shlyuz · To'liq joriy etish) va APC (Demo · Pilot · Joriy etish · Servis shartnomasi).">
  <!-- Hero -->
  <section class="py-20">
    <div class="container-x">
      <div class="max-w-3xl">
        <div class="eyebrow">Nimadan boshlash kerak</div>
        <h1 class="mt-3 text-display-lg">To'rt bosqich. Ikki yo'nalish. Har qadamda aniq artefaktlar.</h1>
        <p class="mt-4 text-lg text-ink-muted">
          Har bir daraja — belgilangan narx, belgilangan muddat, sizda qoladigan aniq natija. Hech qanday «cheksiz konsalting» yo'q — har qadam bu yo hisobot, yo dashbord, yo ishlaydigan kontur.
        </p>
      </div>
    </div>
  </section>

  <!-- Tracks -->
  {tracks.map((track) => (
    <section class="py-12 first-of-type:pt-0 odd:bg-white">
      <div class="container-x">
        <div class="max-w-2xl">
          <div class="eyebrow text-gold-600">{track.eyebrow}</div>
          <h2 class="mt-3 text-display-md">{track.title}</h2>
          <p class="mt-3 text-ink-muted">{track.body}</p>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {track.items.map((item, idx) => (
            <article id={item.id} class="card flex flex-col scroll-mt-24">
              <div class="flex items-center gap-2">
                <span class="rounded-full bg-navy text-cream px-2.5 py-0.5 text-[10px] font-mono font-semibold tracking-widest">{`L${item.level}`}</span>
                <span class="text-[10px] uppercase tracking-[0.18em] text-ink-muted">{item.level}-daraja</span>
              </div>
              <h3 class="mt-4 font-display text-xl font-semibold text-navy">{item.cardTitle}</h3>

              <dl class="mt-5 space-y-3 border-t border-navy/10 pt-4 text-sm">
                <div>
                  <dt class="text-[11px] uppercase tracking-wider text-ink-muted">Narx</dt>
                  <dd class="mt-0.5 font-mono text-base font-semibold text-navy">{item.price}</dd>
                </div>
                <div>
                  <dt class="text-[11px] uppercase tracking-wider text-ink-muted">Muddat</dt>
                  <dd class="mt-0.5 text-navy">{item.duration}</dd>
                </div>
                {item.composition && (
                  <div>
                    <dt class="text-[11px] uppercase tracking-wider text-ink-muted">Tarkib</dt>
                    <dd class="mt-0.5 text-ink-muted">{item.composition}</dd>
                  </div>
                )}
                <div>
                  <dt class="text-[11px] uppercase tracking-wider text-ink-muted">Artefakt</dt>
                  <dd class="mt-0.5 text-ink-muted">{item.artifact}</dd>
                </div>
              </dl>

              <div class="mt-auto pt-6">
                <a href={ladderHref(item)} class="btn-accent w-full justify-center">
                  {idx === 0 ? 'Demoga yozilish →' : `Ariza: ${item.label} →`}
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- FAQ / clarifications -->
  <section class="bg-cream py-20">
    <div class="container-x">
      <div class="max-w-2xl">
        <div class="eyebrow">Ko'p beriladigan savollar</div>
        <h2 class="mt-3 text-display-md">Boshlashdan oldin nimani bilish muhim</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="card">
          <h3 class="font-display text-lg font-semibold text-navy">Qaysi birinchi qadamni tanlash kerak?</h3>
          <p class="mt-2 text-sm text-ink-muted">Agar kritik agregatni allaqachon bilsangiz va ma'lumot xohlasangiz — Diagnostika kuni yoki Pilot shlyuzni oling. Agar jarayonni optimallashtirish — APC pilot. Hali aniqlashtirayotgan bo'lsangiz — Demo, 30 daqiqa, majburiyatsiz.</p>
        </div>
        <div class="card">
          <h3 class="font-display text-lg font-semibold text-navy">Nega pilot uchun to'lash kerak?</h3>
          <p class="mt-2 text-sm text-ink-muted">Pulli pilot «turistlar»ni filtrlaydi va chiqish / shlyuz xarajatlarimizni qoplaydi. Agar davom etishga qaror qilsangiz, pilot narxi to'liq joriy etish TKT summasidan chegiriladi.</p>
        </div>
        <div class="card">
          <h3 class="font-display text-lg font-semibold text-navy">Servis shartnomasi nima?</h3>
          <p class="mt-2 text-sm text-ink-muted">«Natija uchun to'laysiz» modeli. Bazaviy oylik to'lov qo'llab-quvvatlashni qoplaydi, o'zgaruvchan qism — hujjatlar bilan tasdiqlangan tejamning 20%. O'zgaruvchan qism shifti — bazaning 3–4 baravari. Minimal muddat — 36 oy.</p>
        </div>
        <div class="card">
          <h3 class="font-display text-lg font-semibold text-navy">Darhol tenderga bo'ladimi?</h3>
          <p class="mt-2 text-sm text-ink-muted">Ha. Agar ehtiyoj allaqachon shakllangan va tender tayyorlanayotgan bo'lsa — «To'liq joriy etish» bo'yicha yozing: TKT tayyorlaymiz, texnik talablarda yordam beramiz, kerak bo'lsa hajmni aniqlashtirish uchun oldindan Diagnostika kunini o'tkazamiz.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="container-x">
      <div class="rounded-3xl bg-navy px-8 py-14 text-cream md:px-16 md:py-20">
        <div class="max-w-2xl">
          <div class="eyebrow text-gold">Qaysi bosqich sizniki ekaniga ishonchingiz komil emasmi?</div>
          <h2 class="mt-3 font-display text-display-md text-cream">Demodan boshlang. 30 daqiqa, majburiyatsiz.</h2>
          <p class="mt-4 text-cream/70">
            Qo'ng'iroqda referens ma'lumotlar bilan stendni ko'rsatamiz, uskuna parkingizni ko'rib chiqamiz va qaysi birinchi qadam siz uchun mantiqli ekanini aytamiz — Diagnostika kuni, Pilot shlyuz, APC pilot yoki to'g'ridan-to'g'ri TKT.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/uz/?intent=demo-monitoring#contact" class="btn-accent">Demo: monitoring →</a>
            <a href="/uz/?intent=demo-apc#contact" class="btn-ghost !border-cream/20 !bg-white/5 !text-cream hover:!bg-white/10">Demo: APC →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
