---
import Base from '../../../layouts/Base.astro';
import '../../../styles/site.css';

const title = "Yulduz — ServerPro'ning o'z brendi · Toshkentda ishlab chiqarish";
const description =
  "Yulduz — ServerPro'ning o'z mahsulot liniyasi: FVV va FV ogohlantirgichlari hamda ogohlantirish tizimlari, «Rahbar planshet»i. Ishlab chiqarish va ombor Toshkentda, O'zbekiston Respublikasi normalari bo'yicha sertifikatlash, servis — ishlab chiqargan o'sha jamoa tomonidan.";
---
<Base locale="uz" title={title} description={description}>
  <div class="sp">

    <!-- HERO -->
    <section class="yz-hero grid-bg">
      <div class="halo"></div>
      <div class="container">
        <a href="/uz/#yulduz" class="backlink">← ServerPro</a>
        <div class="yz-mark" style="margin-top:20px">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2z"/></svg>
          <span class="lat">Yulduz</span><span class="uz">· Юлдуз</span>
        </div>
        <h1>O'zimiz ishlab chiqaramiz — o'zimiz javob beramiz</h1>
        <p class="sub">Yulduz — ServerPro'ning o'z mahsulot liniyasi. Toshkentdagi o'z maydonchamizda ishlab chiqaradiganimiz: fuqaro muhofazasi va favqulodda vaziyatlar ogohlantirgichlari hamda ogohlantirish tizimlari, shuningdek «Rahbar planshet»i. Ishlab chiqarish va ombor — mahalliy, sertifikatlash — O'zbekiston Respublikasi normalari bo'yicha, servis — ishlab chiqargan o'sha jamoa tomonidan.</p>
        <div class="cta">
          <a href="/uz/#cta" class="btn btn-primary">Yetkazib berishni muhokama qilish <svg class="ic" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a href="/uz/#dirs" class="btn btn-ghost">ServerPro'ning barcha yo'nalishlari</a>
        </div>
      </div>
    </section>

    <!-- PRODUCTS -->
    <section id="products">
      <div class="container">
        <div class="head">
          <span class="eyebrow dark">Yulduz liniyasi</span>
          <h2>Biz nima ishlab chiqaramiz</h2>
          <p class="lead">Har bir obyektga kerak bo'ladigan ommaviy, talab yuqori pozitsiyalar — importni kutgandan ko'ra mahalliy ishlab chiqarish va texnik xizmat ko'rsatish foydaliroq bo'lganlari.</p>
        </div>
        <div class="prod-grid">
          <div class="prod">
            <div class="ico"><svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="2"/><path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5M4.9 19.1C1 15.2 1 8.8 4.9 4.9M19.1 4.9c3.9 3.9 3.9 10.3 0 14.2"/></svg></div>
            <h3>FVV va FV bildirgich va ogohlantirgichlari</h3>
            <p>Fuqaro muhofazasi va favqulodda vaziyatlar to'g'risida ogohlantirish tizimlari uchun ogohlantirish qurilmalari — ovozli va yorug'lik-ovozli.</p>
            <ul>
              <li>Mahalliy ishlab chiqarish — doim omborda</li>
              <li>O'zbekiston Respublikasi normalari bo'yicha sertifikatlash</li>
              <li>Ishlab chiqaruvchi kafolati — bizniki, mahalliy</li>
            </ul>
          </div>
          <div class="prod">
            <div class="ico"><svg class="ic" viewBox="0 0 24 24"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07M19.07 4.93a10 10 0 0 1 0 14.14"/></svg></div>
            <h3>Ogohlantirish va evakuatsiya tizimlari</h3>
            <p>Ogohlantirish majmuasi to'liq: ogohlantirgichdan boshqaruv pultigacha. Loyihalashtiramiz, o'rnatamiz, ishga tushiramiz va texnik xizmat ko'rsatamiz.</p>
            <ul>
              <li>Loyiha, montaj va PNR — o'z kuchimiz bilan</li>
              <li>Import yetkazib berishlarini kutmasdan</li>
              <li>Qo'llab-quvvatlash va ZIP joyida</li>
            </ul>
          </div>
          <div class="prod">
            <div class="ico"><svg class="ic" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M12 18h.01"/></svg></div>
            <h3>Rahbar planshet</h3>
            <p>Egasi va direktor uchun tayyor qurilma: yoqasiz — va korxonani ko'rasiz. Ishlab chiqarish, pul, risklar — onlayn, bitta ekranda.</p>
            <ul>
              <li>Diagnostika bilan bir xil monitoring tizimida ishlaydi</li>
              <li>Aktivning asosiy ko'rsatkichlari — real vaqtda</li>
              <li>Rahbarning vazifalariga moslanadi</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- WHY LOCAL -->
    <section class="why">
      <div class="container">
        <div class="head">
          <span class="eyebrow dark">Nega o'z ishlab chiqarish</span>
          <h2>Mahalliy — demak tezroq, arzonroq va javobgarlik ostida</h2>
        </div>
        <div class="feats">
          <div class="feat">
            <div class="ico"><svg class="ic" viewBox="0 0 24 24"><path d="M20 7 12 3 4 7l8 4 8-4z"/><path d="M4 7v10l8 4 8-4V7"/></svg></div>
            <h3>Toshkentdagi ombor</h3>
            <p>Ommaviy pozitsiyalar doim mavjud — yetkazib berish muddatlari import va logistikaga bog'liq emas.</p>
          </div>
          <div class="feat">
            <div class="ico"><svg class="ic" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></div>
            <h3>O'zbekiston Respublikasi normalari</h3>
            <p>Mahsulot amaldagi mahalliy talablarga moslab tayyorlanadi — begona milliy standartlarni ko'chirmasdan.</p>
          </div>
          <div class="feat">
            <div class="ico"><svg class="ic" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
            <h3>Bitta jamoaning javobgarligi</h3>
            <p>Kim ishlab chiqargan bo'lsa — o'sha loyihalashtiradi, o'rnatadi va texnik xizmat ko'rsatadi. Kafolat va servis chet elga yo'naltirilmaydi.</p>
          </div>
          <div class="feat">
            <div class="ico"><svg class="ic" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M4 10h16M10 10v10"/></svg></div>
            <h3>Yagona tizimning bir qismi</h3>
            <p>Ogohlantirish va «Rahbar planshet»i uskuna diagnostikasi bilan bir xil monitoring platformasida ishlaydi — obyekt yaxlit ko'rinadi.</p>
          </div>
        </div>
        <p class="stack-note" style="color:var(--muted-dark)">Yulduz «Raqamli shahar» yo'nalishida hamkor brendlarni to'ldiradi: ommaviy mahalliy pozitsiyalar kerak bo'lganda — o'zimiz ishlab chiqaramiz; ko'proq ixtisoslashgan ogohlantirish tizimlarini hamkor vendorlardan yetkazib beramiz (masalan, «META» ISHK).</p>
      </div>
    </section>

    <!-- CTA -->
    <section id="cta" class="cta-sec grid-bg">
      <div class="halo"></div>
      <div class="container">
        <div class="head center" style="margin-bottom:24px">
          <span class="eyebrow">Yetkazib berish va loyiha</span>
          <h2 style="color:#fff">Ogohlantirish, evakuatsiya yoki «Rahbar planshet»i kerakmi?</h2>
          <p class="lead" style="color:#c1cdda; margin:14px auto 0">Obyekt haqida gapiring — tarkib, muddat va narxni tanlaymiz. Loyihalashtirish, montaj va servis — o'z kuchimiz bilan.</p>
        </div>
        <div style="text-align:center">
          <a href="/uz/#cta" class="btn btn-primary">Masalani muhokama qilish <svg class="ic" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
    </section>

  </div>
</Base>
