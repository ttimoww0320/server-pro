---
import Base from '../../../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('productsUz');
  return items.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

interface Props { p: CollectionEntry<'productsUz'> }
const { p } = Astro.props;
const { Content } = await p.render();
const specs = p.data.specs ?? {};

// Семейство (enum-ключ в RU) → отображение латиницей.
const familyLabel: Record<string, string> = {
  'Пассер': 'Passer',
  'Ларус': 'Larus',
  'Стрикс': 'Strix',
  'Прочее': 'Boshqa',
};

// Map product slugs to docs.liman-tech.ru deep links
const docsBase = 'https://docs.liman-tech.ru';
const docsLinks: Record<string, string> = {
  'strix-connect': `${docsBase}/`,
  'strix': `${docsBase}/`,
  'larus-10': `${docsBase}/devices/larus/larus-10/`,
  'larus-100': `${docsBase}/devices/larus/larus-100/`,
  'larus-1000': `${docsBase}/devices/larus/`,
  'passer-v': `${docsBase}/devices/passer/passer-v/`,
  'passer-t': `${docsBase}/devices/passer/passer-t/`,
};
const docsHref = docsLinks[p.slug] ?? `${docsBase}/devices/`;
---
<Base locale="uz" title={`${p.data.name}`} description={p.data.summary}>
  <article class="py-20">
    <div class="container-x grid gap-16 md:grid-cols-12">
      <aside class="md:col-span-4 md:sticky md:top-24 md:self-start">
        <a href="/uz/#stack" class="text-sm font-semibold text-navy hover:text-gold-600">← Mahsulotlar</a>
        {p.data.image && (
          <div class="mt-6 overflow-hidden rounded-2xl border border-navy/10 bg-white p-4">
            <img src={p.data.image} alt={p.data.name} class="aspect-[4/3] w-full object-contain" loading="lazy" />
          </div>
        )}
        <div class="eyebrow mt-8">{familyLabel[p.data.family] ?? p.data.family}</div>
        <h1 class="mt-3 text-display-md">{p.data.name}</h1>
        <p class="mt-4 text-ink-muted">{p.data.summary}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`/uz/?intent=demo-monitoring#contact`} class="btn-accent">Demoga yozilish</a>
          <a href={`/uz/?intent=datasheet#contact`} class="btn-ghost text-sm">Datashit so'rash</a>
          <a href={docsHref} target="_blank" rel="noopener noreferrer" class="btn-ghost text-sm">
            Hujjatlar ↗
          </a>
        </div>

        {Object.keys(specs).length > 0 && (
          <div class="mt-10 rounded-2xl border border-navy/10 bg-white p-6 shadow-soft">
            <div class="eyebrow">Xususiyatlar</div>
            <dl class="mt-4 space-y-3 text-sm">
              {Object.entries(specs).map(([k, v]) => (
                <div class="flex items-baseline justify-between gap-4 border-b border-navy/5 pb-3 last:border-0 last:pb-0">
                  <dt class="text-ink-muted">{k}</dt>
                  <dd class="text-right font-medium text-navy">{v}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </aside>

      <div class="md:col-span-8">
        <div class="prose prose-slate prose-headings:font-display prose-headings:text-navy prose-a:text-gold-600 max-w-none">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Base>
