---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('newsUz', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const UZ_MONTHS = ['yanvar', 'fevral', 'mart', 'aprel', 'may', 'iyun', 'iyul', 'avgust', 'sentyabr', 'oktyabr', 'noyabr', 'dekabr'];
const fmt = (d: Date) => `${d.getDate()} ${UZ_MONTHS[d.getMonth()]} ${d.getFullYear()}`;
---
<Base locale="uz" title="Yangiliklar va materiallar">
  <section class="py-20">
    <div class="container-x">
      <div class="eyebrow">Materiallar</div>
      <h1 class="mt-3 text-display-lg">Yangiliklar, obyektlardan hikoyalar va mahsulot yangilanishlari</h1>
      <p class="mt-4 max-w-2xl text-ink-muted">Ishlab chiqarishdan hikoyalar, muhandislik tahlillari va biz keyin nima qurayotganimiz.</p>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => (
          <a href={`/uz/news/${p.slug}/`} class="card card-hover flex flex-col">
            <div class="text-xs uppercase tracking-wider text-ink-muted">
              {fmt(p.data.date)}
            </div>
            <div class="mt-3 font-display text-lg font-semibold text-navy">{p.data.title}</div>
            <p class="mt-2 text-sm text-ink-muted line-clamp-3">{p.data.summary}</p>
            <div class="mt-auto pt-5 text-sm font-semibold text-navy">O'qish →</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
