    <!-- FUNNEL -->
    <section id="how">
      <div class="container">
        <div class="head center">
          <span class="eyebrow dark">Qanday ishlaymiz</span>
          <h2>«Umuman nima mumkin?»dan — raqamlarda erishilgan maqsadgacha</h2>
        </div>
        <div class="steps">
          <div class="step"><div class="num">1</div><h3>Imkoniyatlarni ko'rish</h3><p>Bugun sizning ishlab chiqarishingizda nimalar qilish mumkinligini jonli misollarda ko'rsatamiz — va aynan nima xohlayotganingizni tushunishga yordam beramiz. Demo, keyslar, majburiyatsiz suhbat.</p></div>
          <div class="step"><div class="num">2</div><h3>Masalani aniqlash</h3><p>«Kamroq yo'qotish bo'lsa» degandan aniq masala tug'iladi: qaysi uchastka, qaysi jarayonlar, qanday ma'lumot allaqachon bor. So'rovnomalarni siz uchun to'ldiramiz — uchrashuvda ovozli javob bersangiz kifoya.</p></div>
          <div class="step"><div class="num">3</div><h3>Maqsadni raqamlarda ifodalash</h3><p>Maqsad tekshiriladigan bo'lishi kerak: «samaradorlikni oshirish» emas, «xarajatlarni 30% ga kamaytirish» yoki «ishlab chiqarishni 20% ga oshirish». Samarani qanday o'lchashni — startdan oldin kelishamiz, keyin emas.</p></div>
          <div class="step"><div class="num">4</div><h3>Erishish — va mustahkamlash</h3><p>Pilot bitta uchastkada samarani tasdiqlaydi, shartnoma ishlar hajmini belgilaydi, keyin — masshtablash va texnik xizmat. 3-qadamdagi maqsad qabul qilish mezoniga aylanadi.</p></div>
        </div>
      </div>
    </section>

    <!-- CTA + FORM -->
    <section id="cta" class="cta-sec grid-bg">
      <div class="halo"></div>
      <div class="container">
        <div class="cta-grid">
          <div>
            <span class="eyebrow">Kichikdan boshlaymiz</span>
            <h2 style="margin-top:14px">Masala haqida gapiring — qo'ng'iroqda muhokama qilamiz</h2>
            <p>Ariza qoldiring — bog'lanamiz, masalani ko'rib chiqamiz va so'rovnomalarni tayyorlaymiz (VKSda siz uchun to'ldiramiz). Keyin erishsa bo'ladigan maqsadlarni ifodalaymiz va pilot yoki shartnoma taklif qilamiz. Majburiyatlarsiz.</p>
            <div style="display:flex; gap:22px; margin-top:26px; flex-wrap:wrap">
              <div><div style="font-family:Manrope;font-weight:800;font-size:22px;color:#fff">Toshkent</div><div style="font-size:13.5px;color:#9fb0c3">ofis, ombor, servis</div></div>
              <div><div style="font-family:Manrope;font-weight:800;font-size:22px;color:#fff">UZ · KZ · KG</div><div style="font-size:13.5px;color:#9fb0c3">yetkazib berish mintaqasi</div></div>
            </div>
          </div>
          <form class="form" id="lead-form" method="POST" action={LEAD_ENDPOINT}>
            <input type="hidden" name="intent" value="general" />
            <input type="hidden" name="source_path" value="/uz/" />
            <input type="hidden" name="utm_source" value="" />
            <input type="hidden" name="utm_medium" value="" />
            <input type="hidden" name="utm_campaign" value="" />
            <input type="hidden" name="_subject" value="ServerPro sayti orqali ariza (UZ)" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_captcha" value="false" />
            <!-- honeypot FormSubmit: to'ldirsa botlar — ariza tashlab yuboriladi -->
            <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
            <label for="lead-name">Ism</label>
            <input id="lead-name" type="text" name="name" placeholder="Sizga qanday murojaat qilaylik" required />
            <label for="lead-company">Kompaniya</label>
            <input id="lead-company" type="text" name="company" placeholder="Korxona nomi" required />
            <label for="lead-contact">Telefon yoki e-mail</label>
            <input id="lead-contact" type="text" name="contact" placeholder="+998 ..." required />
            <label for="lead-task">Masala</label>
            <textarea id="lead-task" name="message" rows="3" placeholder="Uskunangiz va masalangiz haqida qisqacha"></textarea>
            <label class="consent">
              <input type="checkbox" name="consent" required />
              <span>Men <a href="/uz/privacy/">shaxsiy ma'lumotlarni qayta ishlashga</a> roziman.</span>
            </label>
            <button class="btn btn-primary" type="submit">Ariza yuborish</button>
            <p class="form-status" id="lead-status" role="status" aria-live="polite"></p>
            <p class="note">Arizani ServerPro menejeri qabul qiladi. Shartnoma — «SERVERPRO» MChJ (O'zbekiston) bilan.</p>
          </form>
          <script is:inline define:vars={{ endpoint: LEAD_ENDPOINT_AJAX, email: LEAD_EMAIL }}>
            (function () {
              var form = document.getElementById('lead-form');
              var status = document.getElementById('lead-status');
              if (!form) return;
              // предзаполнить служебные поля: путь + UTM-метки из адреса
              try {
                var q = new URLSearchParams(location.search);
                if (form.intent && q.get('intent')) form.intent.value = q.get('intent');
                if (form.source_path) form.source_path.value = location.pathname + location.search;
                ['utm_source', 'utm_medium', 'utm_campaign'].forEach(function (k) {
                  if (form.elements[k]) form.elements[k].value = q.get(k) || '';
                });
              } catch (e) {}
              function set(msg, cls) { if (status) { status.innerHTML = msg; status.className = 'form-status' + (cls ? ' ' + cls : ''); } }
              // Нативный (no-JS) фолбэк вернулся с ?lead=ok — показываем успех
              try { if (new URLSearchParams(location.search).get('lead') === 'ok') set('Rahmat! Ariza yuborildi — ish kuni davomida bog\'lanamiz.', 'ok'); } catch (e) {}
              form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (form._honey && form._honey.value) return;           // бот
                if (!form.checkValidity()) { form.reportValidity(); return; }
                var btn = form.querySelector('button[type=submit]');
                var orig = btn ? btn.textContent : '';
                if (btn) { btn.disabled = true; btn.textContent = 'Yuborilmoqda…'; }
                set('', '');
                fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json' }, body: new URLSearchParams(new FormData(form)) })
                  .then(function (r) { if (!r.ok) throw new Error('http ' + r.status); return r.json().catch(function () { return {}; }); })
                  .then(function () {
                    form.reset();
                    set('Rahmat! Ariza yuborildi — ish kuni davomida bog\'lanamiz.', 'ok');
                    if (typeof window.ym === 'function' && window.YM_ID) window.ym(window.YM_ID, 'reachGoal', 'lead_submit');
                  })
                  .catch(function () {
                    set('Yuborib bo\'lmadi. Bizga <a href="mailto:' + email + '">' + email + '</a> manziliga yoki Telegram orqali yozing.', 'err');
                  })
                  .finally(function () { if (btn) { btn.disabled = false; btn.textContent = orig; } });
              });
            })();
          </script>
        </div>
      </div>
    </section>

  </div>
