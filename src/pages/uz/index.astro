---
import Base from '../../layouts/Base.astro';
import '../../styles/site.css';
import { LEAD_ENDPOINT, LEAD_ENDPOINT_AJAX, LEAD_EMAIL } from '../../lib/lead';

const title = 'ServerPro — sanoat, shahar va biznesni raqamlashtirish · Toshkent';
const description =
  "ServerPro — Toshkentdagi muhandislik kompaniyasi: prediktiv vibro- va tok diagnostikasi, uskunalar monitoringi, avtomatlashtirish, raqamli shahar va sun'iy intellektga asoslangan yechimlar. Loyihalashtiramiz, yetkazib beramiz, o'rnatamiz va texnik xizmat ko'rsatamiz — datchikdan dispetcherlik punktigacha.";
---
<Base locale="uz" title={title} description={description}>
  <div class="sp">

    <!-- HERO -->
    <section class="hero grid-bg">
      <picture class="hero-media">
        <source srcset="/images/industry-map.webp" type="image/webp" />
        <img src="/images/industry-map.jpg" alt="Sanoat klasterining izometrik xaritasi: neft-gaz, energetika, metallurgiya, sement, kon qazib olish va dengiz porti" width="1672" height="941" fetchpriority="high" decoding="async" />
      </picture>
      <div class="hero-scrim"></div>
      <div class="halo"></div><div class="halo2"></div>
      <div class="container">
        <span class="eyebrow">Muhandislik kompaniyasi · Toshkent</span>
        <h1>Zamonaviy yechimlar sizning ishlab chiqarishingiz uchun</h1>
        <div class="desc">Sanoat, shahar va biznesni raqamlashtirish</div>
        <p class="sub">ServerPro O'zbekiston korxonalariga zamonaviy raqamli yechimlarni olib keladi va ularni o'z kuchi bilan joriy etadi — datchikdan dispetcherlik punktigacha. Jahon darajasidagi texnologiyalar, muhandislik va servis — mahalliy.</p>
        <div class="cta">
          <a href="#cta" class="btn btn-primary">Masalani muhokama qilish <svg class="ic" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a href="#dirs" class="btn btn-ghost">Bizning yo'nalishlar</a>
        </div>
        <div class="trust">
          <div><span class="n">3</span><span class="l">kalit topshirish yo'nalishi</span></div>
          <div><span class="n">L0–L3</span><span class="l">to'liq diagnostika steki</span></div>
          <div><span class="n">92 kGts</span><span class="l">xom vibratsiya signali</span></div>
          <div><span class="n">Toshkent</span><span class="l">mahalliy ombor va servis</span></div>
        </div>
      </div>
    </section>

    <!-- DIRECTIONS -->
    <section id="dirs">
      <div class="container">
        <div class="head">
          <span class="eyebrow dark">Yo'nalishlar</span>
          <h2>Uch yo'nalish — yagona muhandislik jamoasi</h2>
          <p class="lead">Biz masalani to'liq yopamiz: loyihalashtiramiz, yetakchi ishlab chiqaruvchilarning uskunalarini yetkazib beramiz, yig'amiz, o'rnatamiz va texnik xizmat ko'rsatamiz.</p>
        </div>
        <div class="dirs">
          <div class="dir flag">
            <span class="tag">Flagman</span>
            <div class="ico"><svg class="ic" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
            <h3>Sanoatni raqamlashtirish</h3>
            <p>Prediktiv vibro- va tok diagnostikasi, uskunalar holatining monitoringi va ASU TP optimallashtirilishi. Kamroq avariyaviy to'xtashlar — o'sha uskunadan ko'proq foyda.</p>
            <ul class="dir-list">
              <li>Vibro- va tok diagnostikasi<span class="src">Passer · Larus · Strix.Platforma</span></li>
              <li>Holat monitoringi va ishonchlilik<span class="src">OEE, holatga ko'ra texnik xizmat, to'xtashlarni kamaytirish</span></li>
              <li>ASU TP / APC optimallashtirilishi</li>
              <li>Sanoat aloqasi va xodimlar xavfsizligi<span class="src">X-Connect — ratsiyalar, odam qidirish, yiqilish datchigi, REB-barqarorlik</span></li>
              <li>Operator trenajyorlari<span class="src">LKM — raqamli egizaklarda o'qitish</span></li>
            </ul>
            <a class="more" href="#stack">Stekni ko'rish <svg class="ic" style="width:17px;height:17px" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          </div>
          <div class="dir">
            <div class="ico"><svg class="ic" viewBox="0 0 24 24"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18"/><path d="M2 22h20"/><path d="M10 6h4M10 10h4M10 14h4"/></svg></div>
            <h3>Raqamli shahar</h3>
            <p>Yo'l harakatini boshqarish (ASUDD), FVV va favqulodda vaziyatlar to'g'risida ogohlantirish tizimlari, bino va inshootlarning muhandislik tizimlari monitoringi, yong'in xavfsizligi.</p>
            <ul class="dir-list">
              <li>ASUDD — yo'l harakatini boshqarish<span class="src">Svetofor tartibga solish, transportni aniqlash</span></li>
              <li>FVV va favqulodda vaziyatlar ogohlantiruvi / SOUE<span class="src">O'z brendi Yulduz + «META» ISHK — ogohlantirgichlar, pultlar, evakuatsiya</span></li>
              <li>Yong'in xavfsizligi — «Neptun» YXT <span class="badge-soon"><span class="dot"></span>Mintaqaga tayyorlanmoqda</span><span class="src">Manzilli YXS: datchiklar + PPKU, portlashdan himoyalangan bajarilishlar</span></li>
              <li>Bino va inshootlar monitoringi<span class="src">SMIS · SMIK/SMDS · MFSB</span></li>
            </ul>
            <a class="more" href="#yulduz">O'z brendi Yulduz <svg class="ic" style="width:17px;height:17px" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          </div>
          <div class="dir">
            <div class="ico"><svg class="ic" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"/></svg></div>
            <h3>Boshqaruv va sun'iy intellekt</h3>
            <p>Biznes-jarayonlarni raqamlashtirish, qaror konturida inson ishtirokidagi SI-agentlarni operatsion faoliyatga joriy etish, modellarni o'qitish va mahalliy joylashtirish — ma'lumotlar mamlakat hududida qoladi.</p>
            <ul class="dir-list">
              <li>Biznes-jarayonlarni raqamlashtirish</li>
              <li>Operatsion faoliyatdagi SI-agentlar<span class="src">Qaror konturidagi inson (human-in-loop)</span></li>
              <li>LLM'ni mahalliy joylashtirish<span class="src">Ma'lumotlar mamlakat hududida qoladi</span></li>
              <li>Investitsiya loyihalari uchun TIA ishlab chiqish<span class="src">Texnik yechimlar, CAPEX/OPEX, moliyaviy model, risklarni baholash</span></li>
            </ul>
            <a class="more" href="#how">Qanday ishlaymiz <svg class="ic" style="width:17px;height:17px" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          </div>
        </div>
      </div>
    </section>

    <!-- PAINS -->
    <section id="pains" class="grid-bg">
      <div class="container">
        <div class="head center">
          <span class="eyebrow dark">Tanish vaziyatlar</span>
          <h2>O'zingizni tanidingizmi?</h2>
          <p class="lead" style="margin:14px auto 0">Rahbarlar bilan bo'ladigan har o'ndan to'qqiz suhbat ana shu vaziyatlardan biri bilan boshlanadi. Agar shulardan biri siz haqingizda bo'lsa — bizda ko'rsatadigan narsa bor.</p>
        </div>
        <div class="pain-grid">
          <div class="pain">
            <span class="grp"><span class="dot"></span>Nazorat</span>
            <h3>«Ishdan chiqqani haqida tungi qo'ng'iroqdan bilaman»</h3>
            <p>Holatning onlayn monitoringi nuqsonni <b>ishdan chiqishdan haftalar va oylar oldin</b> ko'rsatadi — har bir tugun bo'yicha qoldiq resurs ko'rinadi. Avariya rejalashtirilgan almashtirishga aylanadi.</p>
          </div>
          <div class="pain">
            <span class="grp"><span class="dot"></span>Nazorat</span>
            <h3>«Zavod hozir qancha ishlab topayotganini hisobotdan bilaman. Va kutaman»</h3>
            <p>Aktivning onlayn iqtisodi: <b>aynan hozir</b> qancha ishlab chiqarayotgani va topayotgani, to'xtash esa — soatlarda emas, darhol pulda. Telefon ekranida, so'rovsiz va kutishsiz.</p>
          </div>
          <div class="pain">
            <span class="grp"><span class="dot"></span>Nazorat</span>
            <h3>«Har bir hisobot — kimningdir talqini»</h3>
            <p>Egasi, moliya direktori va bosh muhandis <b>datchiklardan olingan bir xil ma'lumotlarga</b> qaraydi — shunchaki turli ekranlar orqali. Bitta tizim, bitta haqiqat, hech qanday qayta hikoyasiz.</p>
          </div>
          <div class="pain">
            <span class="grp"><span class="dot"></span>Nazorat</span>
            <h3>«Maydonchalar bir nechta — qayerda ko'proq yo'qotayotganimiz esa savol»</h3>
            <p>Portfel ekrani: barcha maydonchalar alifbo bo'yicha emas, <b>puldagi yo'qotishlar bo'yicha</b> saralangan. Aktivlar xaritasidan aniq tugun va uning prognoziga — ikki bosishda.</p>
          </div>
          <div class="pain">
            <span class="grp"><span class="dot"></span>Pul</span>
            <h3>«ZIP ombori pulni muzlatadi — kerakli detal esa yo'q»</h3>
            <p>Tugunlar bo'yicha qoldiq resurs prognozi ZIP xaridini «har ehtimolga qarshi»dan <b>«almashtirish muddatiga»</b>ga aylantiradi. Ombor haqiqatan kerak bo'ladigan narsani va kerak bo'lganda saqlaydi.</p>
          </div>
          <div class="pain">
            <span class="grp"><span class="dot"></span>Pul</span>
            <h3>«Jadval bo'yicha ta'mirlaymiz: sog'ini almashtiramiz, o'layotganini o'tkazib yuboramiz»</h3>
            <p>Reglament o'rniga holatga ko'ra xizmat ko'rsatish: ishlar haqiqiy eyilish bo'yicha tayinlanadi. Joriy etishlar amaliyotida — <b>rejadan tashqari ta'mirlar 40–60% gacha kamroq</b>.</p>
          </div>
          <div class="pain">
            <span class="grp"><span class="dot"></span>Pul</span>
            <h3>«Elektr energiyasi hisobi o'sib boryapti, qayerga ketayotgani esa noaniq»</h3>
            <p>Eyilgan privod ishdan chiqishdan ancha oldin me'yordan ortiq iste'mol qiladi. Tok diagnostikasi qaysi motorlar ortiqcha yoqayotganini ko'rsatadi — <b>tejam hisoblagich bo'yicha tasdiqlanadi</b>.</p>
          </div>
          <div class="pain">
            <span class="grp"><span class="dot"></span>Pul</span>
            <h3>«Samara tushunarli, ammo byudjetda kapital xarajat yo'q»</h3>
            <p>Xizmat sifatidagi monitoring (EMaaS): uskunani sotib olmasdan, <b>operatsion xarajatlardan</b> oylik to'lov. Bitta uchastkadagi pilotdan boshlanadi — samara masshtablashdan oldin o'lchanadi.</p>
          </div>
          <div class="pain">
            <span class="grp"><span class="dot"></span>Odamlar va park</span>
            <h3>«Bizda vibrodiagnostlar yo'q — bu bilan kim ishlaydi?»</h3>
            <p>Tizim spektrlar emas, <b>tashxis va ishlar ustuvorligini</b> beradi — mexanik uchun tushunarli nariyad. Servis qo'llab-quvvatlashi va mutaxassislaringizni o'qitish — Toshkentdagi muhandislar tomonidan.</p>
          </div>
          <div class="pain">
            <span class="grp"><span class="dot"></span>Odamlar va park</span>
            <h3>«Uskuna eski — raqamlashtirish biz haqimizda emas»</h3>
            <p>Mashinaga aralashmasdan retrofit: ustama datchiklar va tok qisqichlari holat, yuklama va eyilishni <b>hatto 1980-yillardagi dastgohlar uchun ham</b> beradi. Monitoring parkni almashtirishni talab qilmaydi.</p>
          </div>
          <div class="pain">
            <span class="grp"><span class="dot"></span>O'sish</span>
            <h3>«Chiqish va sifat smenadan smenaga sakraydi»</h3>
            <p>Texnologik jarayonni barqarorlashtirish va optimallashtirish: amaldagi ASU TP ustidagi maslahatchi-tizim jarayonni optimumga yaqinroq olib boradi. <b>O'sha uskunadan ko'proq mahsulot</b>; operator konturda qoladi.</p>
          </div>
          <div class="pain">
            <span class="grp"><span class="dot"></span>O'sish</span>
            <h3>«SI haqida hamma gapiradi — ammo ma'lumotni begona bulutga bo'lmaydi»</h3>
            <p>Biznes-jarayonlardagi SI-agentlar va mahalliy joylashtirilgan modellar: hammasi sizning maydonchangizda ishlaydi, <b>ma'lumotlar mamlakatni tark etmaydi</b>, qarorlarni inson tasdiqlaydi.</p>
          </div>
        </div>
        <p class="pains-note">O'z vaziyatingizni topmadingizmi? Uni bizga tasvirlab bering — <a href="#cta">masalani muhokama qilamiz</a> va nimaga yordam bera olishimizni, nimaga esa yo'qligini halol aytamiz.</p>
      </div>
    </section>

    <!-- WHY -->
    <section class="why">
      <div class="container">
        <div class="head">
          <span class="eyebrow dark">Nega ServerPro</span>
          <h2>Jahon texnologiyalari. Mahalliy muhandislik.</h2>
        </div>
        <div class="feats">
          <div class="feat">
            <div class="ico"><svg class="ic" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
            <h3>To'liq siklli muhandislik</h3>
            <p>Loyihalashtiramiz, shkaflarni yig'amiz, o'rnatamiz, past kuchlanishli va yong'in tizimlarini olib boramiz, ishga tushiramiz va texnik xizmat ko'rsatamiz. Qayta sotish emas — o'z qo'limiz bilan joriy etish.</p>
          </div>
          <div class="feat">
            <div class="ico"><svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></div>
            <h3>Jahon darajasidagi texnologiyalar</h3>
            <p>Bently Nevada va SKF darajasidagi prediktiv diagnostika — ammo mahalliy ombor, servis va narx bilan.</p>
          </div>
          <div class="feat">
            <div class="ico"><svg class="ic" viewBox="0 0 24 24"><path d="M21 12a9 9 0 0 0-9-9 9 9 0 0 0-6.36 2.64L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9 9 0 0 0 6.36-2.64L21 16"/><path d="M21 21v-5h-5"/></svg></div>
            <h3>Pilot, servis, o'qitish</h3>
            <p>Audit va pilotdan tortib servis qo'llab-quvvatlashi va mutaxassislaringizni tizim bilan ishlashga o'rgatishgacha.</p>
          </div>
          <div class="feat">
            <div class="ico"><svg class="ic" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
            <h3>Mahalliy mavjudlik</h3>
            <p>Mahalliy yuridik shaxs, ombor, servis markazi va rus tilida qo'llab-quvvatlash — o'zbekcha versiya tayyorlanmoqda.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- STACK -->
    <section id="stack" class="stack-sec grid-bg">
      <div class="container">
        <div class="head">
          <span class="eyebrow">Sanoatni raqamlashtirish · stek</span>
          <h2>Datchikdan egasining dashbordigacha</h2>
          <p class="lead" style="color:#9fb0c3">Bitta tizimning to'rt darajasi — xom signal qarorlarga aylanadi: qayerda tuzatish, qachon tuzatish va bu qancha turadi.</p>
        </div>
        <div class="stack">
          <div class="lvl">
            <div class="lx">L0 · O'lchash</div>
            <h3>Passer</h3>
            <div class="role">Xom signallarni yig'ish</div>
            <p>Yig'ish kontrollerlari: vibratsiya 92 kGts gacha, tok, harorat. Yo'qotishsiz ma'lumot.</p>
          </div>
          <div class="lvl">
            <div class="lx">L1 · Uzatish</div>
            <h3>Larus</h3>
            <div class="role">IIoT-shlyuz · uskuna</div>
            <p>Joyida dastlabki qayta ishlash, buferlash, OT↔IT ko'prigi. Yuqori model — NPU bilan.</p>
          </div>
          <div class="lvl">
            <div class="lx">L2 · Ma'lumot shlyuzi</div>
            <h3>Strix.Shlyuz</h3>
            <div class="role">Strix Gateway · DT</div>
            <p>Ma'lumotni yig'ish va normallashtirish, OT↔IT ko'prigi, edge-integratsiya (MQTT · Modbus · OPC UA).</p>
          </div>
          <div class="lvl">
            <div class="lx">L3 · Platforma</div>
            <h3>Strix.Platforma</h3>
            <div class="role">Tahlil · dashbordlar</div>
            <p>SCADA, dashbordlar, ML, raqamli egizaklar, diagnostika, resurs prognozi, APC — brauzerda.</p>
          </div>
        </div>
        <p class="stack-note">Liniya bo'yicha texnologiya hamkori — <b>ishlab chiqaruvchi Liman-Tech</b>. ServerPro yechimni O'zbekiston va mintaqadagi obyektlarda yetkazib beradi, integratsiya qiladi va texnik xizmat ko'rsatadi.</p>
      </div>
    </section>

    <!-- OFFICE + PRODUCTION -->
    <section id="office">
      <div class="container">
        <div class="head">
          <span class="eyebrow dark">O'z kuchimiz bilan · Toshkent</span>
          <h2>Ofis va ishlab chiqarish maydonchasi</h2>
          <p class="lead">Loyihalashtiramiz, shkaflarni yig'amiz, o'rnatamiz va texnik xizmat ko'rsatamiz — o'zimiz, Toshkentda. Bu «mahalliy va haqiqiy» tamoyilining poydevori, begona brendlar vitrinasi emas.</p>
        </div>
        <div class="duo">
          <div class="duo-col">
            <div class="ch">
              <div class="ico"><svg class="ic" viewBox="0 0 24 24"><path d="M9 2h6a1 1 0 0 1 1 1v1h1a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1V3a1 1 0 0 1 1-1z"/><path d="M9 12h6M9 16h4"/></svg></div>
              <div><h3>Muhandislik ofisi</h3><div class="sub">loyiha va texnik xizmat</div></div>
            </div>
            <ul class="duo-list">
              <li>Loyihalash<span class="src">ASU TP, past kuchlanishli tizimlar, elektrika — ishchi hujjatlar</span></li>
              <li>Texnik hujjatlar<span class="src">Ijroiya, ekspluatatsiya, tenderlar uchun</span></li>
              <li>Xodimlarni o'qitish<span class="src">Buyurtmachi tomonida tizim bilan ishlash</span></li>
            </ul>
          </div>
          <div class="duo-col">
            <div class="ch">
              <div class="ico"><svg class="ic" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
              <div><h3>Ishlab chiqarish maydonchasi</h3><div class="sub">obyektda yig'ish va montaj</div></div>
            </div>
            <ul class="duo-list">
              <li>Avtomatlashtirish shkaflarini yig'ish<span class="src">Butlash, montaj, sinov</span></li>
              <li>Montaj va ishga tushirish-sozlash (PNR)<span class="src">Obyektda, kalit topshirish</span></li>
              <li>Past kuchlanishli tizimlar</li>
              <li>Yong'in xavfsizligi<span class="src">SKPB · MFSB · SMIS</span></li>
              <li>Servis xizmati<span class="src">Kafolat, ZIP, rus tilida qo'llab-quvvatlash</span></li>
            </ul>
          </div>
        </div>
        <p class="stack-note" style="color:var(--muted-dark)">Barcha o'z xizmatlarimizning to'liq ro'yxati — <a href="/uz/services/" style="color:#b98a34;font-weight:600">«Bizning xizmatlar»</a> sahifasida. ServerPro'ning o'z loyihalar portfeli — <a href="/uz/projects/" style="color:#b98a34;font-weight:600">«Bizning loyihalar»</a>.</p>
      </div>
    </section>

    <!-- YULDUZ -->
    <section id="yulduz" style="padding-top:0">
      <div class="container">
        <div class="yz-band">
          <div class="halo"></div>
          <div class="yz-grid">
            <div>
              <span class="eyebrow">O'z brendi · O'zbekistonda ishlab chiqarilgan</span>
              <div class="yz-mark">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2z"/></svg>
                <span class="lat">Yulduz</span><span class="uz">· Юлдуз</span>
              </div>
              <h2>O'zimiz ishlab chiqaramiz — o'zimiz javob beramiz</h2>
              <p class="yz-sub">Yulduz — ServerPro'ning o'z mahsulot liniyasi: FVV va favqulodda vaziyatlar to'g'risida ogohlantirgichlar va ogohlantirish tizimlari, shuningdek «Rahbar planshet»i. Ishlab chiqarish va ombor Toshkentda, O'zbekiston Respublikasi normalari bo'yicha sertifikatlash, servis — ishlab chiqargan o'sha jamoa tomonidan.</p>
