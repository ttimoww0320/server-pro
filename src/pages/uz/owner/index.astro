---
import Base from '../../../layouts/Base.astro';
import { PulseMetric } from '../../../components/ds';

const tickers = [
  { metric: '$24 000', label: 'Daromad / soat', delta: '+3.1%', trend: 'up' as const },
  { metric: '12 daq', label: 'Smenadagi to\'xtash', delta: '−42 daq', trend: 'up' as const },
  { metric: '18 kun', label: 'Ishdan chiqishgacha · nasos-14', delta: '−2 kun', trend: 'down' as const },
  { metric: '87%', label: 'OEE · aktiv-1', delta: '+4 f.p.', trend: 'up' as const },
];

const blocks = [
  {
    title: 'Aktivingiz so\'nggi soatda qancha ishlab topdi',
    body: 'Obyekt bo\'yicha daromad — real vaqtda, smartfonda. «O\'tgan oylik hisobot» emas, aynan hozirgi holat. To\'xtashni ko\'rasiz — raqamni pulda ko\'rasiz.',
  },
  {
    title: 'Qancha yo\'qotdi',
    body: 'To\'xtashlar avtomatik ravishda pulga aylanadi: unumdorlik × mahsulot narxi × davomiylik. Yo\'qotishlar bo\'yicha saralash — analitiksiz, Exceldagi jadvallarsiz.',
  },
  {
    title: 'Vositachilarsiz',
    body: 'Aktiv ko\'rsatkichlariga to\'g\'ridan-to\'g\'ri kirish. Bosh muhandisning qayta hikoyasi emas, pudratchining talqini emas. Bitta ekran — uch rol — korxona haqida bitta haqiqat.',
  },
];
---
<Base locale="uz" title="Egasi uchun — ServerPro" description="Aktivingiz aynan hozir qancha ishlab topayotgani. Daromad, to'xtashlar, risklar — smartfonda, vositachilarsiz.">
  <!-- Hero — Bloomberg-Terminal dark vibe -->
  <section class="relative overflow-hidden bg-navy text-cream">
    <div class="absolute inset-0 grid-bg opacity-20"></div>
    <div class="container-x relative grid gap-12 py-20 md:grid-cols-12 md:py-28">
      <div class="md:col-span-6">
        <span class="inline-flex items-center gap-2 rounded-full bg-gold/15 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-gold">
          <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
          Egasi uchun
        </span>
        <h1 class="mt-6 font-display text-display-xl text-cream">
          Aktiv holati <span class="text-gold">real vaqtda.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-cream/80">
          Aktivingiz aynan hozir qancha ishlab topayotgani, smena davomida qancha yo'qotgani va 30 kunlik ufqda risklar qayerda ekani — smartfonning bitta ekranida.
        </p>
        <p class="mt-4 max-w-xl text-base text-cream/70">
          Vositachilarsiz. Oyiga bir marta hisobotlarsiz. Jamoaning qayta hikoyalarisiz.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/uz/?intent=demo-monitoring#contact" class="btn-accent">Egasi uchun demoni rejalashtirish →</a>
          <a href="/uz/cfo/" class="btn-ghost !border-cream/20 !bg-white/5 !text-cream hover:!bg-white/10">CFO uchun</a>
        </div>
      </div>
      <div class="md:col-span-6">
        <!-- Mobile mockup with live tickers -->
        <div class="mx-auto max-w-xs">
          <div class="rounded-[2.5rem] border-[10px] border-navy-900 bg-navy-900 p-1 shadow-lift">
            <div class="overflow-hidden rounded-[2rem] bg-navy-700">
              <div class="flex items-center justify-between px-5 py-3 text-[10px] font-mono text-cream/60">
                <span>STRIX · OWNER</span>
                <span class="flex items-center gap-1.5">
                  <span class="relative inline-flex h-1.5 w-1.5">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-gold opacity-75"></span>
                    <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-gold"></span>
                  </span>
                  LIVE
                </span>
              </div>
              <div class="space-y-2 px-3 pb-5">
                {tickers.map((t) => (
                  <PulseMetric metric={t.metric} label={t.label} delta={t.delta} trend={t.trend} />
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Three blocks -->
  <section class="py-24">
    <div class="container-x">
      <div class="grid gap-8 md:grid-cols-3">
        {blocks.map((b, i) => (
          <div class="card flex flex-col">
            <div class="eyebrow text-gold-600">0{i + 1}</div>
            <div class="mt-3 font-display text-xl font-semibold text-navy">{b.title}</div>
            <p class="mt-3 text-sm text-ink-muted">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-link -->
  <section class="bg-cream py-16">
    <div class="container-x grid gap-8 md:grid-cols-2">
      <a href="/uz/cfo/" class="card card-hover">
        <div class="eyebrow text-gold-600">CFO uchun</div>
        <div class="mt-2 font-display text-xl font-semibold text-navy">Pul qayerga ketmoqda</div>
        <p class="mt-2 text-sm text-ink-muted">To'xtashlar pulda, moliyaviy ko'rsatkich sifatidagi OEE, servis modeli.</p>
      </a>
      <a href="/uz/engineer/" class="card card-hover">
        <div class="eyebrow text-gold-600">Bosh muhandis uchun</div>
        <div class="mt-2 font-display text-xl font-semibold text-navy">Siz kutgan chuqurlik</div>
        <p class="mt-2 text-sm text-ink-muted">Vibroakustika spektrlari 92 kGts, RUL, APC maslahatchisi.</p>
      </a>
    </div>
  </section>
</Base>
