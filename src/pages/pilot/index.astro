---
import Base from '../../layouts/Base.astro';
import { TRACK_1, TRACK_2, type IntentDef } from '../../lib/intents';

const tracks = [
  {
    title: 'Мониторинг и диагностика',
    eyebrow: 'Трек 1',
    body: 'Если цель — поставить вибро- и токовую диагностику на активы, интегрировать со SCADA / ТОиР и вывести на промышленную эксплуатацию. Конечный результат — поставка железа и ПО (капвложения) или поставка по тендеру.',
    items: TRACK_1,
  },
  {
    title: 'APC и оптимизация процесса',
    eyebrow: 'Трек 2',
    body: 'Если цель — повысить выход, сократить энергию, стабилизировать процесс. Конечный результат — алгоритм APC в контуре. Коммерческая модель: разовая продажа или сервисный контракт (платите за результат).',
    items: TRACK_2,
  },
];

function ladderHref(item: IntentDef) {
  return `/?intent=${item.id}#contact`;
}
---
<Base title="С чего начать" description="Четыре уровня входа по двум трекам: мониторинг (Демо · День диагностики · Пилотный шлюз · Полное внедрение) и APC (Демо · Пилот · Развёртывание · Сервисный контракт).">
  <!-- Hero -->
  <section class="py-20">
    <div class="container-x">
      <div class="max-w-3xl">
        <div class="eyebrow">С чего начать</div>
        <h1 class="mt-3 text-display-lg">Четыре ступени. Два трека. Конкретные артефакты на каждом шаге.</h1>
        <p class="mt-4 text-lg text-ink-muted">
          Каждый уровень — фиксированная цена, фиксированный срок, конкретный результат, который остаётся у вас. Никакого «бесконечного консалтинга» — каждый шаг — это либо отчёт, либо дашборд, либо рабочий контур.
        </p>
      </div>
    </div>
  </section>

  <!-- Tracks -->
  {tracks.map((track) => (
    <section class="py-12 first-of-type:pt-0 odd:bg-white">
      <div class="container-x">
        <div class="max-w-2xl">
          <div class="eyebrow text-gold-600">{track.eyebrow}</div>
          <h2 class="mt-3 text-display-md">{track.title}</h2>
          <p class="mt-3 text-ink-muted">{track.body}</p>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {track.items.map((item, idx) => (
            <article id={item.id} class="card flex flex-col scroll-mt-24">
              <div class="flex items-center gap-2">
                <span class="rounded-full bg-navy text-cream px-2.5 py-0.5 text-[10px] font-mono font-semibold tracking-widest">{`L${item.level}`}</span>
                <span class="text-[10px] uppercase tracking-[0.18em] text-ink-muted">Уровень {item.level}</span>
              </div>
              <h3 class="mt-4 font-display text-xl font-semibold text-navy">{item.cardTitle}</h3>

              <dl class="mt-5 space-y-3 border-t border-navy/10 pt-4 text-sm">
                <div>
                  <dt class="text-[11px] uppercase tracking-wider text-ink-muted">Цена</dt>
                  <dd class="mt-0.5 font-mono text-base font-semibold text-navy">{item.price}</dd>
                </div>
                <div>
                  <dt class="text-[11px] uppercase tracking-wider text-ink-muted">Срок</dt>
                  <dd class="mt-0.5 text-navy">{item.duration}</dd>
                </div>
                {item.composition && (
                  <div>
                    <dt class="text-[11px] uppercase tracking-wider text-ink-muted">Состав</dt>
                    <dd class="mt-0.5 text-ink-muted">{item.composition}</dd>
                  </div>
                )}
                <div>
                  <dt class="text-[11px] uppercase tracking-wider text-ink-muted">Артефакт</dt>
                  <dd class="mt-0.5 text-ink-muted">{item.artifact}</dd>
                </div>
              </dl>

              <div class="mt-auto pt-6">
                <a href={ladderHref(item)} class="btn-accent w-full justify-center">
                  {idx === 0 ? 'Записаться на демо →' : `Заявка: ${item.label} →`}
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- FAQ / clarifications -->
  <section class="bg-cream py-20">
    <div class="container-x">
      <div class="max-w-2xl">
        <div class="eyebrow">Частые вопросы</div>
        <h2 class="mt-3 text-display-md">Что важно знать до начала</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="card">
          <h3 class="font-display text-lg font-semibold text-navy">Какой первый шаг выбрать?</h3>
          <p class="mt-2 text-sm text-ink-muted">Если уже знаете критичный агрегат и хотите данные — берите День диагностики или Пилотный шлюз. Если оптимизация процесса — Пилот APC. Если ещё разбираетесь — Демо, 30 минут, без обязательств.</p>
        </div>
        <div class="card">
          <h3 class="font-display text-lg font-semibold text-navy">Зачем платить за пилот?</h3>
          <p class="mt-2 text-sm text-ink-muted">Платный пилот фильтрует «туристов» и окупает наши затраты на выезд / шлюз. Стоимость пилота вычитается из ТКП на полное внедрение, если вы решаете идти дальше.</p>
        </div>
        <div class="card">
          <h3 class="font-display text-lg font-semibold text-navy">Что такое сервисный контракт?</h3>
          <p class="mt-2 text-sm text-ink-muted">Модель «платите за результат». Базовая ежемесячная плата покрывает поддержку, переменная часть — 20% от документально подтверждённой экономии. Потолок переменной — 3–4× базы. Минимальный срок — 36 месяцев.</p>
        </div>
        <div class="card">
          <h3 class="font-display text-lg font-semibold text-navy">Можно сразу в тендер?</h3>
          <p class="mt-2 text-sm text-ink-muted">Да. Если у вас уже сформирована потребность и идёт подготовка тендера — пишите по «Полному внедрению»: подготовим ТКП, поможем с техническими требованиями, при необходимости проведём предварительный День диагностики для уточнения объёма.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="container-x">
      <div class="rounded-3xl bg-navy px-8 py-14 text-cream md:px-16 md:py-20">
        <div class="max-w-2xl">
          <div class="eyebrow text-gold">Не уверены, какая ступень ваша?</div>
          <h2 class="mt-3 font-display text-display-md text-cream">Начните с демо. 30 минут, без обязательств.</h2>
          <p class="mt-4 text-cream/70">
            На звонке покажем стенд с реальными данными референсов, разберём ваш парк оборудования и подскажем, какой первый шаг для вас имеет смысл — День диагностики, Пилотный шлюз, Пилот APC или сразу ТКП.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/?intent=demo-monitoring#contact" class="btn-accent">Демо: мониторинг →</a>
            <a href="/?intent=demo-apc#contact" class="btn-ghost !border-cream/20 !bg-white/5 !text-cream hover:!bg-white/10">Демо: APC →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
