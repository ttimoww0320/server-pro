---
import Base from '../../layouts/Base.astro';
import { PulseMetric } from '../../components/ds';

const tickers = [
  { metric: '$24 000', label: 'Выручка / час', delta: '+3.1%', trend: 'up' as const },
  { metric: '12 мин', label: 'Простой за смену', delta: '−42 мин', trend: 'up' as const },
  { metric: '18 дней', label: 'До отказа · насос-14', delta: '−2 дня', trend: 'down' as const },
  { metric: '87%', label: 'OEE · актив-1', delta: '+4 п.п.', trend: 'up' as const },
];

const blocks = [
  {
    title: 'Сколько ваш актив заработал за последний час',
    body: 'Выручка по объекту — в реальном времени, на смартфоне. Не «отчёт за прошлый месяц», а состояние прямо сейчас. Видите остановку — видите цифру в деньгах.',
  },
  {
    title: 'Сколько потерял',
    body: 'Простои конвертируются в деньги автоматически: производительность × цена продукта × длительность. Ранжирование по убыткам — без аналитика, без таблиц в Excel.',
  },
  {
    title: 'Без посредников',
    body: 'Доступ напрямую к показателям актива. Не пересказ от главного инженера, не интерпретация от подрядчика. Один экран — три роли — одна правда о предприятии.',
  },
];
---
<Base title="Для собственника — ServerPro" description="Сколько ваш актив зарабатывает прямо сейчас. Выручка, простои, риски — на смартфоне, без посредников.">
  <!-- Hero — Bloomberg-Terminal dark vibe -->
  <section class="relative overflow-hidden bg-navy text-cream">
    <div class="absolute inset-0 grid-bg opacity-20"></div>
    <div class="container-x relative grid gap-12 py-20 md:grid-cols-12 md:py-28">
      <div class="md:col-span-6">
        <span class="inline-flex items-center gap-2 rounded-full bg-gold/15 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-gold">
          <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
          Для собственника
        </span>
        <h1 class="mt-6 font-display text-display-xl text-cream">
          Состояние актива <span class="text-gold">в реальном времени.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-cream/80">
          Сколько ваш актив зарабатывает прямо сейчас, сколько потерял за смену и где риски на горизонте 30 дней — на одном экране смартфона.
        </p>
        <p class="mt-4 max-w-xl text-base text-cream/70">
          Без посредников. Без отчётов раз в месяц. Без пересказов от команды.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/?intent=demo-monitoring#contact" class="btn-accent">Запланировать демо для собственника →</a>
          <a href="/cfo/" class="btn-ghost !border-cream/20 !bg-white/5 !text-cream hover:!bg-white/10">Для CFO</a>
        </div>
      </div>
      <div class="md:col-span-6">
        <!-- Mobile mockup with live tickers -->
        <div class="mx-auto max-w-xs">
          <div class="rounded-[2.5rem] border-[10px] border-navy-900 bg-navy-900 p-1 shadow-lift">
            <div class="overflow-hidden rounded-[2rem] bg-navy-700">
              <div class="flex items-center justify-between px-5 py-3 text-[10px] font-mono text-cream/60">
                <span>STRIX · OWNER</span>
                <span class="flex items-center gap-1.5">
                  <span class="relative inline-flex h-1.5 w-1.5">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-gold opacity-75"></span>
                    <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-gold"></span>
                  </span>
                  LIVE
                </span>
              </div>
              <div class="space-y-2 px-3 pb-5">
                {tickers.map((t) => (
                  <PulseMetric metric={t.metric} label={t.label} delta={t.delta} trend={t.trend} />
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Three blocks -->
  <section class="py-24">
    <div class="container-x">
      <div class="grid gap-8 md:grid-cols-3">
        {blocks.map((b, i) => (
          <div class="card flex flex-col">
            <div class="eyebrow text-gold-600">0{i + 1}</div>
            <div class="mt-3 font-display text-xl font-semibold text-navy">{b.title}</div>
            <p class="mt-3 text-sm text-ink-muted">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-link -->
  <section class="bg-cream py-16">
    <div class="container-x grid gap-8 md:grid-cols-2">
      <a href="/cfo/" class="card card-hover">
        <div class="eyebrow text-gold-600">Для CFO</div>
        <div class="mt-2 font-display text-xl font-semibold text-navy">Где деньги уходят</div>
        <p class="mt-2 text-sm text-ink-muted">Простои в деньгах, OEE как финансовая метрика, сервисная модель.</p>
      </a>
      <a href="/engineer/" class="card card-hover">
        <div class="eyebrow text-gold-600">Для главного инженера</div>
        <div class="mt-2 font-display text-xl font-semibold text-navy">Глубина, которую вы ждёте</div>
        <p class="mt-2 text-sm text-ink-muted">Спектры виброакустики 92 кГц, RUL, советчик APC.</p>
      </a>
    </div>
  </section>
</Base>
