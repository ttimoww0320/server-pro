---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title="Новости и материалы">
  <section class="py-20">
    <div class="container-x">
      <div class="eyebrow">Материалы</div>
      <h1 class="mt-3 text-display-lg">Новости, истории с объектов и обновления продуктов</h1>
      <p class="mt-4 max-w-2xl text-ink-muted">Истории с производства, инженерные разборы и что мы строим дальше.</p>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => (
          <a href={`/news/${p.slug}/`} class="card card-hover flex flex-col">
            <div class="text-xs uppercase tracking-wider text-ink-muted">
              {p.data.date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
            </div>
            <div class="mt-3 font-display text-lg font-semibold text-navy">{p.data.title}</div>
            <p class="mt-2 text-sm text-ink-muted line-clamp-3">{p.data.summary}</p>
            <div class="mt-auto pt-5 text-sm font-semibold text-navy">Читать →</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
