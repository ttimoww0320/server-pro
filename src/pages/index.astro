            <h2 style="margin-top:14px">Расскажите о задаче — обсудим на созвоне</h2>
            <p>Оставьте заявку — созвонимся, разберём задачу и подготовим опросные листы (заполним за вас на ВКС). Дальше сформулируем достижимые цели и предложим пилот или договор. Без обязательств.</p>
            <div style="display:flex; gap:22px; margin-top:26px; flex-wrap:wrap">
              <div><div style="font-family:Manrope;font-weight:800;font-size:22px;color:#fff">Ташкент</div><div style="font-size:13.5px;color:#9fb0c3">офис, склад, сервис</div></div>
              <div><div style="font-family:Manrope;font-weight:800;font-size:22px;color:#fff">UZ · KZ · KG</div><div style="font-size:13.5px;color:#9fb0c3">регион поставки</div></div>
            </div>
          </div>
          <form class="form" id="lead-form" method="POST" action={LEAD_ENDPOINT}>
            <input type="hidden" name="intent" value="general" />
            <input type="hidden" name="source_path" value="/" />
            <input type="hidden" name="utm_source" value="" />
            <input type="hidden" name="utm_medium" value="" />
            <input type="hidden" name="utm_campaign" value="" />
            <input type="hidden" name="_subject" value="Заявка с сайта ServerPro" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_captcha" value="false" />
            <!-- honeypot FormSubmit: заполнят боты — заявка отбрасывается -->
            <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
            <label for="lead-name">Имя</label>
            <input id="lead-name" type="text" name="name" placeholder="Как к вам обращаться" required />
            <label for="lead-company">Компания</label>
            <input id="lead-company" type="text" name="company" placeholder="Название предприятия" required />
            <label for="lead-contact">Телефон или e-mail</label>
            <input id="lead-contact" type="text" name="contact" placeholder="+998 ..." required />
            <label for="lead-task">Задача</label>
            <textarea id="lead-task" name="message" rows="3" placeholder="Коротко о вашем оборудовании и задаче"></textarea>
            <label class="consent">
              <input type="checkbox" name="consent" required />
              <span>Согласен на обработку <a href="/privacy/">персональных данных</a>.</span>
            </label>
            <button class="btn btn-primary" type="submit">Отправить заявку</button>
            <p class="form-status" id="lead-status" role="status" aria-live="polite"></p>
            <p class="note">Заявку получает менеджер ServerPro. Договор — с ООО «SERVERPRO» (Узбекистан).</p>
          </form>
          <script is:inline define:vars={{ endpoint: LEAD_ENDPOINT_AJAX, email: LEAD_EMAIL }}>
            (function () {
              var form = document.getElementById('lead-form');
              var status = document.getElementById('lead-status');
              if (!form) return;
              // предзаполнить служебные поля: путь + UTM-метки из адреса
              try {
                var q = new URLSearchParams(location.search);
                if (form.intent && q.get('intent')) form.intent.value = q.get('intent');
                if (form.source_path) form.source_path.value = location.pathname + location.search;
                ['utm_source', 'utm_medium', 'utm_campaign'].forEach(function (k) {
                  if (form.elements[k]) form.elements[k].value = q.get(k) || '';
                });
              } catch (e) {}
              function set(msg, cls) { if (status) { status.innerHTML = msg; status.className = 'form-status' + (cls ? ' ' + cls : ''); } }
              // Нативный (no-JS) фолбэк вернулся с ?lead=ok — показываем успех
              try { if (new URLSearchParams(location.search).get('lead') === 'ok') set('Спасибо! Заявка отправлена — свяжемся в течение рабочего дня.', 'ok'); } catch (e) {}
              form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (form._honey && form._honey.value) return;           // бот
                if (!form.checkValidity()) { form.reportValidity(); return; }
                var btn = form.querySelector('button[type=submit]');
                var orig = btn ? btn.textContent : '';
                if (btn) { btn.disabled = true; btn.textContent = 'Отправляем…'; }
                set('', '');
                fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json' }, body: new URLSearchParams(new FormData(form)) })
                  .then(function (r) { if (!r.ok) throw new Error('http ' + r.status); return r.json().catch(function () { return {}; }); })
                  .then(function () {
                    form.reset();
                    set('Спасибо! Заявка отправлена — свяжемся в течение рабочего дня.', 'ok');
                    if (typeof window.ym === 'function' && window.YM_ID) window.ym(window.YM_ID, 'reachGoal', 'lead_submit');
                  })
                  .catch(function () {
                    set('Не удалось отправить. Напишите нам на <a href="mailto:' + email + '">' + email + '</a> или в Telegram.', 'err');
                  })
                  .finally(function () { if (btn) { btn.disabled = false; btn.textContent = orig; } });
              });
            })();
          </script>
        </div>
      </div>
    </section>

