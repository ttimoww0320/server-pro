---
import Logo from './Logo.astro';
import { ui, getLocale, altLocale, localizedPath, switchLocalePath, type Locale } from '../i18n/strings';

interface Props {
  locale?: Locale;
}
const { locale = getLocale(Astro.url.pathname) } = Astro.props;
const t = ui[locale];

// Навигация зеркалит прототип v0.15. Якоря ведут на секции главной через `/#…`,
// чтобы работать и с внутренних страниц. Пути локализуются: RU — корень, UZ — /uz/.
const nav = t.nav.map((item) => ({ href: localizedPath(item.path, locale), label: item.label }));
const ctaHref = localizedPath('/#cta', locale);
const homeHref = localizedPath('/', locale);

// Переключатель языка ведёт на эквивалент текущей страницы на другой локали.
const other = altLocale(locale);
const switchHref = switchLocalePath(Astro.url.pathname, other);
const switchShort = t.switchToShort;
const switchFull = t.switchTo;
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-navy/90 backdrop-blur-md">
  <div class="container-x flex h-16 items-center justify-between">
    <a href={homeHref} class="flex items-center gap-2 text-cream" aria-label={t.home}>
      <Logo class="h-7 w-auto text-cream" />
    </a>
    <nav class="hidden gap-7 md:flex">
      {nav.map((item) => (
        <a href={item.href} class="text-sm font-medium text-navy-300 transition-colors hover:text-cream">
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-2 md:gap-3">
      <a
        href={switchHref}
        data-lang={other}
        class="lang-switch hidden sm:inline text-xs font-semibold uppercase tracking-wider text-navy-300 transition-colors hover:text-cream"
        aria-label={switchFull}
        hreflang={other}
      >
        {switchShort}
      </a>
      <a href={ctaHref} class="hidden sm:inline-flex items-center rounded-lg bg-gold px-4 py-2 text-sm font-bold text-navy transition-colors hover:bg-gold-300">
        {t.cta.discuss}
      </a>
      <button
        type="button"
        id="mobile-menu-toggle"
        class="md:hidden grid h-10 w-10 place-items-center rounded-lg border border-white/15 text-cream hover:bg-white/5"
        aria-label={t.menu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M3 6h18 M3 12h18 M3 18h18"/></svg>
        <svg id="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden h-5 w-5"><path d="M6 6l12 12 M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-navy">
    <nav class="container-x flex flex-col py-3">
      {nav.map((item) => (
        <a href={item.href} class="border-b border-white/5 py-3 text-base font-medium text-cream last:border-0">
          {item.label}
        </a>
      ))}
      <div class="mt-3 flex items-center justify-between gap-3">
        <a href={switchHref} data-lang={other} hreflang={other} class="lang-switch rounded-lg border border-white/15 px-3 py-2 text-xs font-semibold uppercase tracking-wider text-cream">{switchShort} · {switchFull}</a>
        <a href={ctaHref} class="flex-1 inline-flex justify-center rounded-lg bg-gold px-4 py-3 text-sm font-bold text-navy">
          {t.cta.discuss}
        </a>
      </div>
    </nav>
  </div>
</header>
<script is:inline>
  (function () {
    const btn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      const open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
      iconOpen && iconOpen.classList.toggle('hidden', open);
      iconClose && iconClose.classList.toggle('hidden', !open);
    });
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        iconOpen && iconOpen.classList.remove('hidden');
        iconClose && iconClose.classList.add('hidden');
      });
    });
  })();

  // Явный выбор языка фиксируется в cookie `lang` — на случай, если позже появится
  // собственный рантайм с гео-редиректом (см. src/lib/lead.ts). На чистой статике не влияет.
  (function () {
    document.querySelectorAll('.lang-switch').forEach(function (a) {
      a.addEventListener('click', function () {
        var l = a.getAttribute('data-lang');
        if (l === 'ru' || l === 'uz') {
          document.cookie = 'lang=' + l + '; path=/; max-age=31536000; samesite=lax';
        }
      });
    });
  })();
</script>
