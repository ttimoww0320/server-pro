---
interface Props {
  variant?: 'wordmark' | 'mark';
  class?: string;
}
const { variant = 'wordmark', class: className = '' } = Astro.props;
---
{variant === 'wordmark' ? (
  <svg
    class={className}
    viewBox="0 0 210 44"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="ServerPro"
  >
    <!-- Mark: concentric sonic arcs forming the 'o' -->
    <g transform="translate(4, 8)">
      <circle cx="14" cy="14" r="4" fill="currentColor" />
      <path d="M 4 14 A 10 10 0 0 1 24 14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" />
      <path d="M -1 14 A 15 15 0 0 1 29 14" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.55" />
    </g>
    <!-- Wordmark -->
    <text
      x="38"
      y="30"
      font-family="Manrope, system-ui, sans-serif"
      font-size="24"
      font-weight="600"
      letter-spacing="-0.02em"
      fill="currentColor"
    >ServerPro</text>
  </svg>
) : (
  <svg
    class={className}
    viewBox="0 0 32 32"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="ServerPro"
  >
    <circle cx="16" cy="16" r="16" fill="#0E1B2C" />
    <circle cx="16" cy="16" r="3.5" fill="#D4A24C" />
    <path d="M 7 16 A 9 9 0 0 1 25 16" stroke="#FAF7F2" stroke-width="1.6" fill="none" stroke-linecap="round" />
    <path d="M 3 16 A 13 13 0 0 1 29 16" stroke="#FAF7F2" stroke-width="1.2" fill="none" stroke-linecap="round" opacity="0.55" />
  </svg>
)}
