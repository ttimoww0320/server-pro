---
// Web analytics: Яндекс.Метрика + Cloudflare Web Analytics.
//
// У ServerPro пока нет собственного счётчика — задать через env:
//   PUBLIC_YM_ID  — Yandex.Metrika counter ID
//   PUBLIC_CF_BEACON_TOKEN — Cloudflare Web Analytics token (опционально;
//     CF Pages вставляет свой beacon автоматически, если включить
//     "Web Analytics" в dashboard).

// Метрика отключена по умолчанию (нет ID). Включить можно через PUBLIC_YM_ID env.
const ymId = import.meta.env.PUBLIC_YM_ID || '';
const cfToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---
{ymId && (
  <Fragment>
    <script is:inline define:vars={{ ymId }}>
      window.YM_ID = ymId;
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
      m[i].l=1*new Date();
      for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
      k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
      (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

      ym(ymId, "init", {
         ssr: true,
         webvisor: true,
         clickmap: true,
         ecommerce: "dataLayer",
         referrer: document.referrer,
         url: location.href,
         accurateTrackBounce: true,
         trackLinks: true
      });
    </script>
    <noscript><div><img src={`https://mc.yandex.ru/watch/${ymId}`} style="position:absolute; left:-9999px;" alt="" /></div></noscript>
  </Fragment>
)}
{cfToken && (
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${cfToken}"}`}></script>
)}
