# ServerPro — переменные окружения продакшн-сервера (server/index.mjs).
# Скопируйте в .env (или задайте в окружении/секретах пода) и заполните.
# .env в git НЕ коммитится (см. .gitignore).

# Порт HTTP-сервера
PORT=3000

# ── Telegram: куда падают заявки с формы ──
# Токен бота от @BotFather. Держать в секрете — на сервере, НЕ в коде страницы.
TELEGRAM_BOT_TOKEN=

# chat_id группы для заявок (для супергрупп — отрицательное число, напр. -1001234567890).
# Как узнать: добавьте бота в группу, отправьте туда сообщение и откройте
#   https://api.telegram.org/bot<ТОКЕН>/getUpdates — chat_id будет в поле chat.id.
LEAD_CHAT_ID=

# (опц.) message_thread_id темы, если группа — форум с темами. Иначе оставьте пустым.
LEAD_THREAD_ID=

# (опц.) e-mail, показываемый пользователю в тексте ошибки отправки (fallback-контакт).
LEAD_FALLBACK_EMAIL=info@server-pro.uz

# Локальная проверка без реальной отправки: DRY_RUN=true — заявка только логируется
# (пропускает и Telegram, и Odoo).
# DRY_RUN=true

# ── Odoo CRM (опционально): дублирование заявки в вашу CRM-воронку ──
# Если ODOO_* или CRM_TEAM_ID пусты — шаг Odoo тихо пропускается (заявка всё равно уходит в Telegram).
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_PASSWORD=
ODOO_COMPANY_ID=         # id компании в вашей Odoo
ODOO_SALESPERSON_ID=     # id ответственного; пусто/0 = не назначать
CRM_TEAM_ID=             # id команды продаж (воронки)
